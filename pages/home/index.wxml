<view class="home-page">
  <view class="home-header">
    <view class="brand-line">
      <view class="brand-mark">华</view>
      <view>
        <view class="brand-name">华业门窗</view>
        <view class="brand-note">专注门窗定制与安装</view>
      </view>
    </view>
    <view class="service-area"><text class="service-area__dot"></text>本地上门量尺</view>
  </view>

  <view class="hero">
    <image class="hero__image" src="/assets/cases/living-after.jpg" mode="aspectFill" />
    <view class="hero__shade"></view>
    <view class="hero__copy">
      <view class="hero__kicker">换窗之前，先看一眼</view>
      <view class="hero__title"><text>装进你家</text><text>大概是什么样</text></view>
      <view class="hero__text">上传一张现场照片，选择可施工方案查看效果。</view>
    </view>
  </view>

  <view class="experience-panel">
    <button class="primary-button experience-panel__main" bindtap="goUpload">上传照片看效果</button>
    <text class="experience-panel__sample" bindtap="trySample">没有照片？先用客厅样例体验</text>
  </view>

  <view class="trust-strip">
    <view class="trust-item"><text class="trust-item__value">01</text><text class="trust-item__label">只替换门窗</text></view>
    <view class="trust-item"><text class="trust-item__value">02</text><text class="trust-item__label">方案可施工</text></view>
    <view class="trust-item"><text class="trust-item__value">03</text><text class="trust-item__label">满意再预约</text></view>
  </view>

  <view class="home-section home-section--needs">
    <view class="section-heading">
      <view class="section-heading__title">你最想改善什么？</view>
      <text class="section-link" bindtap="goSolutions">按需求选方案</text>
    </view>
    <view class="need-grid">
      <view class="need-item pressable" bindtap="goSolutions"><text class="need-item__mark">静</text><text class="need-item__name">临街隔音</text></view>
      <view class="need-item pressable" bindtap="goSolutions"><text class="need-item__mark">暖</text><text class="need-item__name">保温节能</text></view>
      <view class="need-item pressable" bindtap="goSolutions"><text class="need-item__mark">安</text><text class="need-item__name">安全防护</text></view>
      <view class="need-item pressable" bindtap="goSolutions"><text class="need-item__mark">景</text><text class="need-item__name">通景采光</text></view>
    </view>
  </view>

  <view class="home-section home-section--solutions">
    <view class="section-heading">
      <view class="section-heading__title">真实改造方案</view>
      <text class="section-link" bindtap="goSolutions">查看全部</text>
    </view>
    <scroll-view class="solution-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="solution-scroll__track">
        <view wx:for="{{featuredSolutions}}" wx:key="id" wx:for-item="solution" class="solution-scroll__item">
          <solution-card solution="{{solution}}" compact bind:select="onSolutionSelect" />
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="service-footer">
    <view class="service-footer__title">华业门窗 · 本地服务</view>
    <view class="service-footer__text">效果仅作方案沟通参考，尺寸、价格与施工方式以上门量尺为准。</view>
  </view>
</view>
