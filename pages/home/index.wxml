<view class="home-page">
  <view class="hero {{compareAnimating ? 'hero--animating' : ''}}">
    <image class="hero__image" src="/assets/generated/home-hero-mobile.jpg" mode="aspectFill" />
    <view class="hero__before" style="width: {{comparePosition}}%;">
      <image class="hero__before-image" src="/assets/generated/home-hero-before.jpg" mode="aspectFill" />
    </view>

    <view class="compare-label compare-label--before" style="top: {{labelTop}}px;">改造前</view>
    <view class="compare-label compare-label--after" style="top: {{labelTop}}px;">改造后</view>

    <view class="compare-divider" style="left: {{comparePosition}}%;">
      <view
        class="compare-handle {{compareDragging ? 'compare-handle--dragging' : ''}}"
        aria-role="slider"
        aria-label="拖动查看门窗改造前后效果"
        aria-valuemin="8"
        aria-valuemax="92"
        aria-valuenow="{{comparePosition}}"
        catchtouchstart="onCompareStart"
        catchtouchmove="onCompareMove"
        catchtouchend="onCompareEnd"
        catchtouchcancel="onCompareEnd"
      >
        <view class="compare-handle__arrow compare-handle__arrow--left"></view>
        <view class="compare-handle__arrow compare-handle__arrow--right"></view>
      </view>
    </view>
  </view>

  <view class="hero-intro">
    <view class="hero-intro__title t-display"><text>换窗前，</text><text>先看装进家里的样子</text></view>
    <view class="hero-intro__subtitle"><text class="hero-intro__line"></text><text>上传现场照片，选择可施工方案，拖动查看改造前后</text></view>
  </view>

  <view class="action-zone">
    <button class="primary-button primary-action" hover-class="button-hover" bindtap="goUpload">
      <view class="ic ic--camera ic--white"></view>
      <text>用我家照片预览</text>
    </button>
    <view class="action-zone__hint">支持现场拍摄或从相册选择</view>
    <button class="text-button sample-link" hover-class="text-button--pressed" loading="{{loadingSample}}" disabled="{{loadingSample || openingFlow}}" bindtap="trySample"><text>先用示例照片试试</text><text class="sample-link__arrow"></text></button>
  </view>

  <view class="process-strip">
    <view class="process-item">
      <text class="process-item__index">01</text>
      <view class="process-item__title">上传照片</view>
      <view class="process-item__detail">拍摄或相册</view>
    </view>
    <view class="process-item">
      <text class="process-item__index">02</text>
      <view class="process-item__title">框选门窗</view>
      <view class="process-item__detail">只改框内</view>
    </view>
    <view class="process-item">
      <text class="process-item__index">03</text>
      <view class="process-item__title">选择方案</view>
      <view class="process-item__detail">颜色与玻璃</view>
    </view>
    <view class="process-item">
      <text class="process-item__index">04</text>
      <view class="process-item__title">对比效果</view>
      <view class="process-item__detail">满意再约量尺</view>
    </view>
  </view>

  <view class="home-section home-section--needs">
    <view class="section-heading">
      <view class="section-heading__title t-serif">你最想改善什么？</view>
      <view class="section-link" bindtap="goSolutions">全部方案</view>
    </view>
    <view class="need-grid">
      <view class="need-item pressable" bindtap="goSolutions"><image class="need-item__icon" src="/assets/icons/needs/airflow@3x.png" mode="aspectFit" /><view class="need-item__copy"><text class="need-item__name">通风舒适</text><text class="need-item__detail">改善闷热与空气流通</text></view></view>
      <view class="need-item pressable" bindtap="goSolutions"><image class="need-item__icon" src="/assets/icons/needs/soundproof@3x.png" mode="aspectFit" /><view class="need-item__copy"><text class="need-item__name">隔音降噪</text><text class="need-item__detail">降低临街与室外噪音</text></view></view>
      <view class="need-item pressable" bindtap="goSolutions"><image class="need-item__icon" src="/assets/icons/needs/daylight@3x.png" mode="aspectFit" /><view class="need-item__copy"><text class="need-item__name">采光明亮</text><text class="need-item__detail">让室内保留更多自然光</text></view></view>
      <view class="need-item pressable" bindtap="goSolutions"><image class="need-item__icon" src="/assets/icons/needs/security@3x.png" mode="aspectFit" /><view class="need-item__copy"><text class="need-item__name">安全安心</text><text class="need-item__detail">加强门窗与居家防护</text></view></view>
    </view>
  </view>

  <view class="home-section home-section--solutions">
    <view class="section-heading section-heading--solutions">
      <view>
        <view class="section-heading__title t-serif">适合这些换窗场景</view>
        <view class="section-heading__description">从生活问题出发，找到更容易沟通的方案</view>
      </view>
      <view class="section-link" bindtap="goSolutions">查看全部</view>
    </view>
    <view wx:if="{{loadingSolutions}}" class="empty-state"><view class="empty-state__text">正在加载方案…</view></view>
    <view wx:elif="{{solutionsError}}" class="empty-state">
      <view class="empty-state__text">{{solutionsError}}</view>
      <button class="secondary-button" bindtap="loadFeatured">重新加载</button>
    </view>
    <view wx:elif="{{!featuredSolutions.length}}" class="empty-state"><view class="empty-state__text">暂无可用方案，请稍后再来。</view></view>
    <scroll-view wx:else class="solution-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="solution-scroll__track">
        <view wx:for="{{featuredSolutions}}" wx:key="id" wx:for-item="solution" class="solution-scroll__item"><solution-card solution="{{solution}}" compact bind:select="onSolutionSelect" /></view>
      </view>
    </scroll-view>
  </view>

  <view class="home-section home-section--proof">
    <view class="section-heading">
      <view>
        <view class="section-heading__title t-serif">为什么不是随便生成</view>
        <view class="section-heading__description">效果预览始终围绕真实门窗方案展开</view>
      </view>
    </view>
    <view class="proof-list">
      <view class="proof-item"><view class="proof-item__title">方案来自产品库</view><view class="proof-item__detail">只展示已有门窗方案和可沟通的配置，不生成无法施工的造型。</view></view>
      <view class="proof-item"><view class="proof-item__title">围绕原空间预览</view><view class="proof-item__detail">以你上传的现场照片为起点，重点查看门窗区域的变化。</view></view>
      <view class="proof-item"><view class="proof-item__title">最终仍需现场确认</view><view class="proof-item__detail">尺寸、价格和施工方式，以上门量尺后的确认结果为准。</view></view>
    </view>
    <view class="service-footer">效果图仅供方案沟通参考，尺寸、价格与施工方式以上门量尺为准。</view>
  </view>
</view>
