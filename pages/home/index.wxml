<view class="home-page">
  <view class="hero {{compareAnimating ? 'hero--animating' : ''}}">
    <image class="hero__image" src="/assets/generated/home-hero-mobile.jpg" mode="aspectFill" />
    <view class="hero__before" style="width: {{comparePosition}}%;">
      <image class="hero__before-image" src="/assets/generated/home-hero-before.jpg" mode="aspectFill" />
    </view>

    <view class="compare-label compare-label--before">改造前</view>
    <view class="compare-label compare-label--after">改造后</view>

    <view class="compare-divider" style="left: {{comparePosition}}%;">
      <view
        class="compare-handle {{compareDragging ? 'compare-handle--dragging' : ''}}"
        aria-role="slider"
        aria-label="拖动查看门窗改造前后效果"
        aria-valuemin="8"
        aria-valuemax="92"
        aria-valuenow="{{comparePosition}}"
        catchtouchstart="onCompareStart"
        catchtouchmove="onCompareMove"
        catchtouchend="onCompareEnd"
        catchtouchcancel="onCompareEnd"
      >
        <view class="compare-handle__arrow compare-handle__arrow--left"></view>
        <view class="compare-handle__arrow compare-handle__arrow--right"></view>
      </view>
    </view>
  </view>

  <view class="hero-intro">
    <view class="hero-intro__title">换窗前后，一眼看清</view>
    <view class="hero-intro__subtitle"><text class="hero-intro__line"></text><text>上传你家的照片，生成可施工门窗预览 · 当前为演示体验</text></view>
  </view>

  <view class="action-zone">
    <button class="primary-action" hover-class="button-hover" bindtap="goUpload">
      <view class="primary-action__label"><text>上传照片，体验</text><text class="ai-word">AI</text><text>效果</text></view>
    </button>
    <button class="sample-link" hover-class="sample-link--pressed" bindtap="trySample"><text>没有照片？先看样例效果</text><text class="sample-link__arrow"></text></button>
  </view>

  <view class="trust-strip">
    <view class="trust-item"><view class="trust-icon trust-icon--window"></view><text>只换门窗</text></view>
    <view class="trust-item"><view class="trust-icon trust-icon--check"><view></view></view><text>可施工方案</text></view>
    <view class="trust-item"><view class="trust-icon trust-icon--heart"><view></view></view><text>满意再约</text></view>
  </view>

  <view class="home-section home-section--needs">
    <view class="section-heading">
      <view class="section-heading__title">你最想改善什么？</view>
      <text class="section-link" bindtap="goSolutions">查看全部方案</text>
    </view>
    <view class="need-grid">
      <view class="need-item pressable" bindtap="goSolutions"><view class="need-item__mark need-item__mark--air need-icon need-icon--air"><view></view><view></view><view></view></view><text class="need-item__name">通风舒适</text><text class="need-item__detail">闷热与空气流通</text></view>
      <view class="need-item pressable" bindtap="goSolutions"><view class="need-item__mark need-item__mark--sound need-icon need-icon--sound"><view class="sound-core"></view><view class="sound-wave sound-wave--one"></view><view class="sound-wave sound-wave--two"></view></view><text class="need-item__name">隔音降噪</text><text class="need-item__detail">降低外界噪音</text></view>
      <view class="need-item pressable" bindtap="goSolutions"><view class="need-item__mark need-item__mark--light need-icon need-icon--light"><view class="light-core"></view><view class="light-ray light-ray--h"></view><view class="light-ray light-ray--v"></view></view><text class="need-item__name">采光明亮</text><text class="need-item__detail">提升自然光线</text></view>
      <view class="need-item pressable" bindtap="goSolutions"><view class="need-item__mark need-item__mark--safe need-icon need-icon--safe"><view class="safe-shield"><view class="safe-lock"></view></view></view><text class="need-item__name">安全安心</text><text class="need-item__detail">增强居家防护</text></view>
    </view>
  </view>

  <view class="home-section home-section--solutions">
    <view class="section-heading section-heading--solutions">
      <view><view class="section-heading__title">真实方案，先看效果</view><view class="section-heading__description">对应可量尺、可沟通的门窗配置</view></view>
      <text class="section-link" bindtap="goSolutions">查看全部</text>
    </view>
    <scroll-view class="solution-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="solution-scroll__track">
        <view wx:for="{{featuredSolutions}}" wx:key="id" wx:for-item="solution" class="solution-scroll__item"><solution-card solution="{{solution}}" compact bind:select="onSolutionSelect" /></view>
      </view>
    </scroll-view>
  </view>

  <view class="service-footer"><view class="service-footer__text">页面住宅图片均为生成的演示素材。效果仅供方案沟通参考，尺寸、价格与施工方式以上门量尺为准。</view></view>
</view>
