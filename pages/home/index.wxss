.home-page {
  padding-bottom: 56rpx;
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 22rpx;
}

.brand-line {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-mark {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  background: #1f5637;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
}

.brand-name {
  font-size: 30rpx;
  font-weight: 800;
}

.brand-note {
  margin-top: 4rpx;
  color: #777d78;
  font-size: 19rpx;
}

.service-area {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #59615b;
  font-size: 20rpx;
}

.service-area__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1f5637;
}

.hero {
  position: relative;
  height: 690rpx;
  margin: 0 20rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #dfe3dc;
}

.hero__image,
.hero__shade {
  position: absolute;
  width: 100%;
  height: 100%;
}

.hero__shade {
  background: linear-gradient(180deg, rgba(14, 19, 16, 0.03) 20%, rgba(14, 19, 16, 0.84) 100%);
}

.hero__copy {
  position: absolute;
  right: 36rpx;
  bottom: 52rpx;
  left: 36rpx;
  color: #ffffff;
}

.hero__kicker {
  font-size: 23rpx;
  font-weight: 650;
}

.hero__title {
  margin-top: 12rpx;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.16;
}

.hero__title text {
  display: block;
}

.hero__text {
  max-width: 590rpx;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
  line-height: 1.55;
}

.experience-panel {
  position: relative;
  z-index: 1;
  margin: -20rpx 32rpx 0;
  padding: 22rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(37, 43, 38, 0.1);
}

.experience-panel__main {
  width: 100%;
}

.experience-panel__sample {
  display: block;
  padding: 22rpx 0 2rpx;
  color: #536159;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.trust-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 32rpx;
}

.trust-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  border-right: 1rpx solid #d8dad4;
  text-align: center;
}

.trust-item:last-child {
  border-right: 0;
}

.trust-item__value {
  color: #1f5637;
  font-size: 20rpx;
  font-weight: 800;
}

.trust-item__label {
  color: #4e554f;
  font-size: 22rpx;
  font-weight: 650;
}

.home-section {
  padding: 68rpx 32rpx 0;
}

.section-link {
  padding: 10rpx 0 4rpx 20rpx;
  color: #1f5637;
  font-size: 22rpx;
  font-weight: 650;
}

.need-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.need-item {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-direction: column;
  gap: 14rpx;
  padding: 24rpx 6rpx 22rpx;
  border: 1rpx solid #d8dad4;
  border-radius: 10rpx;
  background: #f8f8f5;
}

.need-item__mark {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e3ebe5;
  color: #1f5637;
  font-size: 23rpx;
  font-weight: 800;
}

.need-item__name {
  max-width: 100%;
  color: #3f4641;
  font-size: 20rpx;
  font-weight: 650;
  white-space: nowrap;
}

.home-section--solutions {
  padding-right: 0;
}

.home-section--solutions .section-heading {
  padding-right: 32rpx;
}

.solution-scroll {
  width: 100%;
}

.solution-scroll__track {
  display: flex;
  gap: 20rpx;
  padding-right: 32rpx;
}

.solution-scroll__item {
  flex: none;
  width: 530rpx;
}

.service-footer {
  margin: 72rpx 32rpx 0;
  padding-top: 30rpx;
  border-top: 1rpx solid #d6d8d2;
}

.service-footer__title {
  color: #333a35;
  font-size: 23rpx;
  font-weight: 700;
}

.service-footer__text {
  margin-top: 8rpx;
  color: #7b807b;
  font-size: 20rpx;
  line-height: 1.55;
}
