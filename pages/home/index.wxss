.home-page {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background: var(--paper-ground);
}

/* 英雄区：同机位前后对比 */
.hero {
  position: relative;
  height: 760rpx;
  overflow: hidden;
  background: var(--paper-tint);
}

.hero__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero__before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  will-change: width;
}

.hero__before-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
  max-width: none;
  height: 760rpx;
}

.hero .compare-label {
  box-shadow: 0 6rpx 18rpx rgba(17, 25, 20, 0.18);
}

.hero .compare-divider {
  box-shadow: 0 0 0 1px rgba(31, 44, 36, 0.12), 0 4rpx 16rpx rgba(17, 25, 20, 0.24);
}

.hero .compare-handle {
  top: 47%;
}

.hero--animating .hero__before,
.hero--animating .compare-divider {
  transition: width 760ms cubic-bezier(0.16, 1, 0.3, 1), left 760ms cubic-bezier(0.16, 1, 0.3, 1);
}

/* 标题与主操作 */
.hero-intro {
  padding: 40rpx 32rpx 0;
}

.hero-intro__title text {
  display: block;
}

.hero-intro__subtitle {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.hero-intro__line {
  width: 30rpx;
  height: 2rpx;
  margin-top: 18rpx;
  flex: none;
  background: var(--clay);
}

.action-zone {
  padding: 32rpx 32rpx 8rpx;
}

.primary-action {
  min-height: 108rpx;
  box-shadow: 0 14rpx 30rpx rgba(36, 66, 51, 0.18);
}

.action-zone__hint {
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.sample-link {
  display: flex;
  width: auto;
  margin: 0 auto;
}

.sample-link__arrow {
  width: 10rpx;
  height: 10rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  transform: rotate(45deg);
}

/* 四步流程条：一条细线框住的横向说明 */
.process-strip {
  display: flex;
  margin: 24rpx 32rpx 0;
  padding: 28rpx 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.process-item {
  min-width: 0;
  flex: 1;
  padding: 0 12rpx;
  border-left: 1px solid var(--line-soft);
}

.process-item:first-child {
  padding-left: 0;
  border-left: 0;
}

.process-item__index {
  display: block;
  color: var(--clay);
  font-size: 22rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.process-item__title {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  white-space: nowrap;
}

.process-item__detail {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.45;
}

/* 分区 */
.home-section {
  padding: 64rpx 32rpx 0;
}

.section-heading--solutions {
  padding-right: 32rpx;
}

/* 需求入口 2 × 2 */
.need-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.need-item {
  display: flex;
  min-width: 0;
  width: calc(50% - 8rpx);
  min-height: 148rpx;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  border: 1px solid var(--line);
  border-radius: 16rpx;
  background: var(--paper-surface);
  text-align: left;
  transition: transform 160ms var(--ease-out), border-color 160ms ease;
}

.need-item:active {
  border-color: var(--green);
  transform: scale(0.98);
}

.need-item__icon {
  display: block;
  width: 72rpx;
  height: 72rpx;
  flex: none;
}

.need-item__copy {
  min-width: 0;
}

.need-item__name {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  white-space: nowrap;
}

.need-item__detail {
  display: block;
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.45;
}

/* 精选方案：唯一的色带，承载横向滚动 */
.home-section--solutions {
  margin-top: 64rpx;
  padding-top: 56rpx;
  padding-right: 0;
  padding-bottom: 56rpx;
  background: var(--paper-muted);
}

.solution-scroll {
  width: 100%;
}

.solution-scroll__track {
  display: flex;
  gap: 16rpx;
  padding-right: 32rpx;
}

.solution-scroll__item {
  width: 420rpx;
  flex: none;
}

/* 可信说明：白纸承接 */
.home-section--proof {
  padding-top: 64rpx;
  padding-bottom: 24rpx;
  background: var(--paper-surface);
}

.home-section--proof .section-heading {
  margin-bottom: 8rpx;
}

.proof-list {
  border-top: 1px solid var(--line);
}

.proof-item {
  display: flex;
  gap: 32rpx;
  padding: 28rpx 0;
  border-bottom: 1px solid var(--line);
}

.proof-item__title {
  width: 210rpx;
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.55;
}

.proof-item__detail {
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.service-footer {
  padding: 40rpx 16rpx 8rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.65;
  text-align: center;
}
