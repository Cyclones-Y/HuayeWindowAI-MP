.home-page {
  min-height: 100vh;
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
  background: #f6f1e7;
}

.hero {
  position: relative;
  height: 760rpx;
  overflow: hidden;
  background: #c9c6bb;
}

.hero__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero__before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  will-change: width;
}

.hero__before-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
  max-width: none;
  height: 760rpx;
}

.compare-label {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 96rpx);
  display: flex;
  min-height: 54rpx;
  align-items: center;
  padding: 0 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 16rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(17, 25, 20, 0.2);
  font-size: 21rpx;
  font-weight: 720;
  text-shadow: 0 2rpx 8rpx rgba(12, 18, 14, 0.3);
}

.compare-label--before {
  left: 32rpx;
  background: rgba(55, 58, 54, 0.68);
}

.compare-label--after {
  right: 32rpx;
  background: rgba(34, 64, 48, 0.84);
}

.compare-divider {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 0 0 1rpx rgba(31, 44, 36, 0.12), 0 5rpx 18rpx rgba(17, 25, 20, 0.26);
  will-change: left;
}

.compare-handle {
  position: absolute;
  top: 47%;
  left: 50%;
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border: 1rpx solid rgba(34, 50, 42, 0.16);
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 14rpx 32rpx rgba(24, 35, 29, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  transform: translate(-50%, -50%);
  transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 160ms ease;
}

.compare-handle--dragging {
  box-shadow: 0 18rpx 38rpx rgba(24, 35, 29, 0.3), inset 0 1rpx 0 rgba(255, 255, 255, 0.96);
  transform: translate(-50%, -50%) scale(1.06);
}

.compare-handle__arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #22322a;
  border-right: 3rpx solid #22322a;
}

.compare-handle__arrow--left { transform: rotate(-135deg); }
.compare-handle__arrow--right { transform: rotate(45deg); }

.hero--animating .hero__before,
.hero--animating .compare-divider {
  transition: width 760ms cubic-bezier(0.16, 1, 0.3, 1), left 760ms cubic-bezier(0.16, 1, 0.3, 1);
}

.hero-intro {
  padding: 38rpx 32rpx 0;
}

.hero-intro__title {
  font-family: "Songti SC", STSong, serif;
  color: #1e241f;
  font-size: 46rpx;
  font-weight: 760;
  line-height: 1.25;
}

.hero-intro__subtitle {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 14rpx;
  color: #5b6058;
  font-size: 21rpx;
  line-height: 1.55;
}

.hero-intro__line {
  width: 30rpx;
  height: 2rpx;
  margin-top: 14rpx;
  flex: none;
  background: #c79a54;
}

.action-zone { padding: 28rpx 32rpx 0; }

.primary-action {
  display: flex;
  width: 686rpx;
  max-width: 100%;
  min-height: 112rpx;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  border-radius: 34rpx;
  background: #22322a;
  color: #fffdf7;
  box-shadow: 0 18rpx 38rpx rgba(34, 50, 42, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
  font-size: 29rpx;
  font-weight: 720;
  white-space: nowrap;
  transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 160ms ease;
}

.primary-action__label {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex: none;
  white-space: nowrap;
}

.ai-word {
  color: #c79a54;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 0.92em;
  font-weight: 800;
}

.sample-link {
  display: flex;
  width: auto;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 4rpx auto 0;
  padding: 0 20rpx;
  background: transparent;
  color: #34483d;
  font-size: 23rpx;
  font-weight: 650;
  transition: opacity 160ms ease;
}

.sample-link--pressed { opacity: 0.55; }

.sample-link__arrow {
  width: 10rpx;
  height: 10rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  transform: rotate(45deg);
}

.trust-strip {
  display: flex;
  margin: 0 32rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(43, 51, 45, 0.13);
  border-bottom: 1rpx solid rgba(43, 51, 45, 0.13);
}

.trust-item {
  display: flex;
  min-width: 0;
  min-height: 46rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-right: 1rpx solid rgba(43, 51, 45, 0.13);
  color: #5b6058;
  font-size: 21rpx;
  font-weight: 700;
}

.trust-item:last-child { border-right: 0; }

.trust-icon {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex: none;
  color: #34483d;
}

.trust-icon--window { border: 2rpx solid currentColor; border-radius: 5rpx; }
.trust-icon--window::before,
.trust-icon--window::after { position: absolute; background: currentColor; content: ""; }
.trust-icon--window::before { top: 0; bottom: 0; left: 50%; width: 2rpx; }
.trust-icon--window::after { top: 50%; right: 0; left: 0; height: 2rpx; }
.trust-icon--check { border: 2rpx solid currentColor; border-radius: 50%; }
.trust-icon--check view { position: absolute; top: 7rpx; left: 8rpx; width: 13rpx; height: 7rpx; border-bottom: 3rpx solid currentColor; border-left: 3rpx solid currentColor; transform: rotate(-45deg); }
.trust-icon--heart view { position: absolute; top: 4rpx; left: 4rpx; width: 24rpx; height: 20rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; border-radius: 4rpx 10rpx 4rpx 10rpx; transform: rotate(45deg); }

.home-section { padding: 72rpx 32rpx 0; }

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.section-heading__title {
  font-family: "Songti SC", STSong, serif;
  font-size: 38rpx;
  font-weight: 760;
  line-height: 1.25;
}

.section-heading__description { margin-top: 10rpx; color: #5b6058; font-size: 21rpx; line-height: 1.45; }

.section-link {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  flex: none;
  color: #5b6058;
  font-size: 21rpx;
}

.need-grid { display: flex; gap: 8rpx; }

.need-item {
  display: flex;
  min-width: 0;
  min-height: 204rpx;
  flex: 1;
  align-items: center;
  flex-direction: column;
  gap: 10rpx;
  padding: 14rpx 2rpx 8rpx;
  border-radius: 28rpx;
  text-align: center;
  transition: transform 160ms ease, background-color 160ms ease;
}

.need-item:active { background: rgba(255, 253, 248, 0.72); transform: scale(0.975); }

.need-item__mark {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
  border-radius: 50%;
  color: #fffdf7;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.25), 0 12rpx 24rpx rgba(34, 50, 42, 0.11);
}

.need-item__mark--air { background: #6f8466; }
.need-item__mark--sound { background: #b97658; }
.need-item__mark--light { background: #9f7a48; }
.need-item__mark--safe { background: #69716b; }
.need-icon { position: relative; }
.need-icon--air { flex-direction: column; gap: 9rpx; }
.need-icon--air view { width: 42rpx; height: 3rpx; border-radius: 2rpx; background: currentColor; }
.need-icon--air view:nth-child(2) { width: 54rpx; }
.sound-core { width: 17rpx; height: 24rpx; border: 3rpx solid currentColor; border-radius: 7rpx; }
.sound-wave { position: absolute; top: 50%; border: 3rpx solid currentColor; border-left: 0; border-radius: 0 50% 50% 0; transform: translateY(-50%); }
.sound-wave--one { right: 21rpx; width: 13rpx; height: 31rpx; }
.sound-wave--two { right: 12rpx; width: 23rpx; height: 46rpx; }
.light-core { width: 25rpx; height: 25rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.light-ray { position: absolute; background: currentColor; }
.light-ray--h { width: 57rpx; height: 3rpx; }
.light-ray--v { width: 3rpx; height: 57rpx; }
.safe-shield { display: flex; width: 45rpx; height: 50rpx; align-items: center; justify-content: center; border: 3rpx solid currentColor; border-radius: 18rpx 18rpx 24rpx 24rpx; }
.safe-lock { width: 13rpx; height: 16rpx; border: 3rpx solid currentColor; border-radius: 6rpx; }
.need-item__name { max-width: 100%; color: #1e241f; font-size: 22rpx; font-weight: 720; white-space: nowrap; }
.need-item__detail { max-width: 132rpx; color: #5b6058; font-size: 18rpx; line-height: 1.42; }

.home-section--solutions {
  margin-top: 44rpx;
  padding-top: 60rpx;
  padding-right: 0;
  padding-bottom: 64rpx;
  background: #e9e3d7;
}

.section-heading--solutions { padding-right: 32rpx; }
.solution-scroll { width: 100%; }
.solution-scroll__track { display: flex; gap: 18rpx; padding-right: 32rpx; }
.solution-scroll__item { width: 410rpx; flex: none; }

.service-footer { padding: 42rpx 48rpx 12rpx; background: #fffdf8; }
.service-footer__text { color: #686c65; font-size: 20rpx; line-height: 1.65; text-align: center; }
