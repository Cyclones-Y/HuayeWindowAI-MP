.home-page {
  padding-bottom: 64rpx;
  background: #f8f5f0;
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: calc(env(safe-area-inset-top) + 12rpx) 210rpx 0 32rpx;
}

.home-header__spacer { display: none; }

.home-header__title {
  flex: none;
  font-size: 34rpx;
  font-weight: 720;
  text-align: left;
}

.home-header__service {
  display: none;
  color: #244233;
  font-size: 21rpx;
  font-weight: 650;
  text-align: right;
}

.hero {
  position: relative;
  height: 760rpx;
  overflow: hidden;
  background: #e4e4dc;
}

.hero__image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero__copy {
  position: absolute;
  top: 116rpx;
  left: 44rpx;
  width: 330rpx;
  color: #262c23;
}

.hero__title {
  font-size: 56rpx;
  font-weight: 760;
  line-height: 1.4;
}

.hero__title text {
  display: block;
}

.hero__accent {
  width: 48rpx;
  height: 4rpx;
  margin-top: 24rpx;
  border-radius: 2rpx;
  background: #c07048;
}

.experience-panel {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 16rpx;
  margin: -48rpx 32rpx 0;
}

.experience-panel__main {
  flex: 1.08;
  box-shadow: 0 16rpx 34rpx rgba(38, 44, 35, 0.14);
}

.experience-panel__sample {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 6rpx;
  padding: 0 18rpx;
  font-size: 21rpx;
  line-height: 1.25;
}

.trust-strip {
  display: flex;
  margin: 38rpx 32rpx 0;
  padding: 30rpx 12rpx;
  border-radius: 16rpx;
  background: #e4e4dc;
}

.trust-item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
  padding: 0 14rpx;
  border-right: 1rpx solid #c8c8c0;
  text-align: center;
}

.trust-item:last-child {
  border-right: 0;
}

.trust-item__value {
  color: #244233;
  font-size: 23rpx;
  font-weight: 720;
}

.trust-item__label {
  color: #555b55;
  font-size: 21rpx;
  line-height: 1.45;
}

.home-section {
  padding: 78rpx 32rpx 0;
}

.section-link {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  padding: 0 0 0 20rpx;
  color: #244233;
  font-size: 22rpx;
  font-weight: 650;
}

.need-grid {
  display: flex;
  border-top: 1rpx solid #d8d5ce;
  border-bottom: 1rpx solid #d8d5ce;
}

.need-item {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  flex-direction: column;
  gap: 10rpx;
  padding: 28rpx 8rpx 26rpx;
  border-right: 1rpx solid #d8d5ce;
  text-align: center;
}

.need-item:last-child {
  border-right: 0;
}

.need-item__mark {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #7e8b82;
  border-radius: 18rpx;
  color: #244233;
}

.need-icon {
  position: relative;
}

.need-icon--air {
  flex-direction: column;
  gap: 7rpx;
}

.need-icon--air view {
  width: 32rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: #244233;
}

.need-icon--air view:nth-child(2) { width: 42rpx; }

.sound-core {
  width: 12rpx;
  height: 18rpx;
  border: 2rpx solid #244233;
  border-radius: 6rpx;
}

.sound-wave {
  position: absolute;
  top: 50%;
  border: 2rpx solid #244233;
  border-left: 0;
  border-radius: 0 50% 50% 0;
  transform: translateY(-50%);
}

.sound-wave--one { right: 13rpx; width: 10rpx; height: 24rpx; }
.sound-wave--two { right: 7rpx; width: 17rpx; height: 36rpx; }

.light-core {
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid #244233;
  border-radius: 50%;
}

.light-ray {
  position: absolute;
  background: #244233;
}

.light-ray--h { width: 42rpx; height: 2rpx; }
.light-ray--v { width: 2rpx; height: 42rpx; }

.safe-shield {
  display: flex;
  width: 34rpx;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #244233;
  border-radius: 15rpx 15rpx 20rpx 20rpx;
}

.safe-lock {
  width: 10rpx;
  height: 12rpx;
  border: 2rpx solid #244233;
  border-radius: 5rpx;
}

.need-item__name {
  max-width: 100%;
  color: #343a35;
  font-size: 21rpx;
  font-weight: 680;
  white-space: nowrap;
}

.need-item__detail {
  color: #565d56;
  font-size: 20rpx;
  line-height: 1.45;
}

.home-section--solutions {
  padding-right: 0;
}

.home-section--solutions .section-heading {
  padding-right: 32rpx;
}

.solution-scroll {
  width: 100%;
}

.solution-scroll__track {
  display: flex;
  gap: 18rpx;
  padding-right: 32rpx;
}

.solution-scroll__item {
  flex: none;
  width: 430rpx;
}

.service-footer {
  margin: 72rpx 32rpx 0;
  padding-top: 30rpx;
  border-top: 1rpx solid #d8d5ce;
}

.service-footer__text {
  color: #565d56;
  font-size: 20rpx;
  line-height: 1.55;
  text-align: center;
}

.service-footer .demo-badge {
  margin: 0 auto 18rpx;
}
