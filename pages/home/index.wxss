.home-page {
  padding-bottom: 48rpx;
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 24rpx;
}

.brand-line {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-mark {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #285c3a;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
}

.brand-name {
  font-size: 29rpx;
  font-weight: 750;
}

.brand-note {
  margin-top: 4rpx;
  color: #7a7e78;
  font-size: 19rpx;
}

.hero {
  position: relative;
  height: 680rpx;
  overflow: hidden;
  background: #dfe3dc;
}

.hero__image,
.hero__shade {
  position: absolute;
  width: 100%;
  height: 100%;
}

.hero__shade {
  background: linear-gradient(180deg, rgba(22, 30, 25, 0.08) 28%, rgba(22, 30, 25, 0.8) 100%);
}

.hero__copy {
  position: absolute;
  right: 40rpx;
  bottom: 48rpx;
  left: 40rpx;
  color: #ffffff;
}

.hero__kicker {
  font-size: 25rpx;
  font-weight: 600;
}

.hero__title {
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.16;
}

.hero__text {
  max-width: 600rpx;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
  line-height: 1.55;
}

.hero-actions {
  display: grid;
  grid-template-columns: 1.45fr 1fr;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #fcfbf8;
}

.hero-actions__main,
.hero-actions__secondary {
  width: 100%;
  min-width: 0;
  padding: 0 18rpx;
}

.trust-strip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
  padding: 26rpx 32rpx;
  border-top: 1rpx solid #e1e2dc;
  border-bottom: 1rpx solid #e1e2dc;
  color: #777b75;
  font-size: 21rpx;
  line-height: 1.5;
}

.trust-strip view {
  display: flex;
  flex-direction: column;
}

.trust-strip__strong {
  color: #285c3a;
  font-size: 25rpx;
  font-weight: 700;
}

.home-section {
  padding: 72rpx 32rpx 0;
}

.steps {
  border-top: 1rpx solid #d8dad3;
}

.step-row {
  display: grid;
  grid-template-columns: 88rpx 1fr;
  gap: 22rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #e1e2dc;
}

.step-row__number {
  color: #285c3a;
  font-size: 25rpx;
  font-weight: 800;
}

.step-row__title {
  font-size: 28rpx;
  font-weight: 700;
}

.step-row__text {
  margin-top: 8rpx;
  color: #747873;
  font-size: 23rpx;
  line-height: 1.55;
}

.section-link {
  padding: 12rpx 0 4rpx 20rpx;
  color: #285c3a;
  font-size: 23rpx;
  font-weight: 650;
}

.home-section--solutions {
  padding-right: 0;
}

.home-section--solutions .section-heading {
  padding-right: 32rpx;
}

.solution-scroll {
  width: 100%;
}

.solution-scroll__track {
  display: flex;
  gap: 20rpx;
  padding-right: 32rpx;
}

.solution-scroll__item {
  flex: none;
  width: 550rpx;
}

.disclaimer {
  margin: 72rpx 32rpx 0;
  padding-top: 24rpx;
  border-top: 1rpx solid #dfe0da;
  color: #858881;
  font-size: 21rpx;
  line-height: 1.55;
}
