<view class="page-shell with-action-bar confirm-page">
  <view class="flow-step"><text>效果预览</text><text>04 / 04</text></view>
  <view class="page-title"><text>最后确认颜色</text><text>和玻璃配置</text></view>
  <view class="page-subtitle">这些选择会用于生成效果，最终配置以上门量尺沟通为准。</view>

  <view class="preview-stage" style="{{stageStyle}}">
    <image class="preview-stage__photo" src="{{photoPath}}" mode="aspectFit" />
    <view wx:if="{{overlayStyle}}" class="preview-stage__box" style="{{overlayStyle}}"></view>
    <view class="preview-stage__tag">将替换框内门窗</view>
  </view>

  <view class="config-summary">
    <image class="config-summary__thumb" src="{{solution.thumbnail}}" mode="aspectFill" />
    <view class="config-summary__copy">
      <view class="config-summary__name">{{solution.name}}</view>
      <view class="config-summary__subtitle">{{solution.subtitle}}</view>
      <view class="config-summary__features">
        <text wx:for="{{solution.features}}" wx:key="*this" wx:for-item="feature">{{feature}}</text>
      </view>
    </view>
  </view>

  <view class="option-section">
    <view class="option-title">边框颜色</view>
    <view class="option-grid">
      <view wx:for="{{frameColors}}" wx:key="code" wx:for-item="option" class="option-item pressable {{frameColorCode === option.code ? 'option-item--active' : ''}}" data-code="{{option.code}}" bindtap="selectFrameColor">
        <view class="option-swatch" style="background: {{option.color}};"></view>
        <text>{{option.name}}</text>
      </view>
    </view>
  </view>

  <view class="option-section">
    <view class="option-title">玻璃配置</view>
    <view class="option-grid">
      <view wx:for="{{glassOptions}}" wx:key="code" wx:for-item="option" class="option-item option-item--text pressable {{glassCode === option.code ? 'option-item--active' : ''}}" data-code="{{option.code}}" bindtap="selectGlass">{{option.name}}</view>
    </view>
  </view>

  <view class="notice confirm-notice">
    <view class="notice__text">效果图用于帮助你理解方案和沟通需求，最终尺寸、配置与价格以上门量尺为准。</view>
  </view>

  <view class="action-bar">
    <button class="primary-button" hover-class="button-hover" bindtap="startGeneration">生成门窗预览</button>
  </view>
</view>
