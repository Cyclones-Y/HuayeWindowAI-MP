/* 用户照片与选框：明确告诉用户将替换哪一块 */
.preview-stage {
  position: relative;
  width: 100%;
  height: 420rpx;
  margin: 32rpx auto 0;
  overflow: hidden;
  border-radius: 16rpx;
  background: var(--stage);
}

.preview-stage__photo {
  display: block;
  width: 100%;
  height: 100%;
}

.preview-stage__box {
  position: absolute;
  border: 3rpx solid var(--stage-accent);
  border-radius: 6rpx;
  box-shadow: 0 0 0 1000rpx rgba(10, 13, 11, 0.42);
}

.preview-stage__tag {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  display: flex;
  min-height: 44rpx;
  align-items: center;
  padding: 0 14rpx;
  border-radius: 14rpx;
  background: rgba(38, 44, 35, 0.78);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

/* 所选方案摘要 */
.config-summary {
  display: flex;
  gap: 24rpx;
  margin-top: 28rpx;
  padding: 24rpx 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.config-summary__thumb {
  width: 176rpx;
  height: 132rpx;
  flex: none;
  border-radius: 16rpx;
  background: var(--paper-tint);
}

.config-summary__copy {
  min-width: 0;
  flex: 1;
}

.config-summary__name {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.config-summary__subtitle {
  margin-top: 4rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.config-summary__features {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 12rpx;
  color: var(--green);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.5;
}

/* 配置选项 */
.option-section {
  margin-top: 40rpx;
}

.option-title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  display: flex;
  width: calc(50% - 8rpx);
  min-height: 96rpx;
  align-items: center;
  gap: 14rpx;
  padding: 0 22rpx;
  border: 1px solid var(--line);
  border-radius: 24rpx;
  background: var(--paper-surface);
  color: var(--ink);
  font-size: 24rpx;
  line-height: 1.4;
  transition: transform 160ms var(--ease-out), background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
}

.option-item--text {
  justify-content: center;
  text-align: center;
}

.option-item--active {
  border-color: var(--green);
  background: var(--green-soft);
  color: var(--green);
  box-shadow: 0 0 0 2rpx var(--green);
  font-weight: 600;
}

.option-swatch {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 1px var(--line);
}

.confirm-notice {
  margin-top: 40rpx;
}

/* 告知文案与按钮纵向排列，窄屏也不能把生成按钮压成单字竖排。 */
.confirm-page.with-action-bar { padding-bottom: calc(310rpx + env(safe-area-inset-bottom)); }
.confirm-page .action-bar { flex-direction: column; gap: 14rpx; }
.confirm-page .action-bar button { width: 100%; flex: none; }
