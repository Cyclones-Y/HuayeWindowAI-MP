.solutions-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.solutions-count {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex: none;
  padding-bottom: 8rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.solutions-count__number {
  color: var(--green);
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.filter-block {
  margin-top: 40rpx;
  padding-top: 28rpx;
  border-top: 1px solid var(--line);
}

.filter-block--compact {
  margin-top: 24rpx;
  padding-top: 0;
  border-top: 0;
}

.filter-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.filter-label__hint {
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 400;
}

.filter-scroll {
  width: calc(100% + 32rpx);
}

.solution-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 40rpx;
}

.solution-skeleton {
  height: 520rpx;
  border-radius: 16rpx;
}

.retry-button {
  width: 260rpx;
  min-width: 260rpx;
  max-width: 260rpx;
  margin-top: 28rpx;
}
