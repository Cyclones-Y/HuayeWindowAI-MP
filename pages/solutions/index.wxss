.solutions-page {
  padding-top: 40rpx;
}

.solutions-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.solutions-count {
  flex: none;
  padding-bottom: 8rpx;
  color: #687069;
  font-size: 22rpx;
}

.solutions-count text {
  margin-right: 6rpx;
  color: #244233;
  font-size: 38rpx;
  font-weight: 750;
}

.filter-block {
  margin-top: 48rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #d8d5ce;
}

.filter-block--compact {
  margin-top: 30rpx;
  padding-top: 0;
  border-top: 0;
}

.filter-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  color: #343a35;
  font-size: 25rpx;
  font-weight: 650;
}

.filter-label__hint {
  color: #565d56;
  font-size: 21rpx;
  font-weight: 400;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  padding-right: 20rpx;
}

.filter-chip {
  flex: none;
  min-height: 88rpx;
  padding: 0 28rpx;
  border: 1rpx solid #cfd2cb;
  border-radius: 24rpx;
  background: #fffefa;
  color: #4f564f;
  font-size: 24rpx;
  line-height: 88rpx;
  transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease;
}

.filter-chip--active {
  border-color: #244233;
  background: #244233;
  color: #ffffff;
  font-weight: 650;
}

.solution-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 42rpx;
}

.solution-skeleton {
  height: 520rpx;
  border-radius: 16rpx;
}

.retry-button {
  width: 260rpx;
  margin-top: 30rpx;
}
