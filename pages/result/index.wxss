.result-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.result-head {
  padding: 36rpx 32rpx 32rpx;
}

.result-state {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #596159;
  font-size: 23rpx;
  font-weight: 600;
}

.result-state text {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #244233;
}

.result-title {
  margin-top: 18rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.result-subtitle {
  margin-top: 12rpx;
  color: #626861;
  font-size: 24rpx;
  line-height: 1.6;
}

.compare-stage {
  position: relative;
  height: 760rpx;
  overflow: hidden;
  background: #e4e4dc;
}

.compare-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.compare-before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
}

.compare-label {
  position: absolute;
  top: 24rpx;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(29, 34, 30, 0.78);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 650;
}

.compare-label--before { left: 24rpx; }
.compare-label--after { right: 24rpx; background: rgba(36, 66, 51, 0.94); }

.compare-handle {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  transform: translateX(-1rpx);
  pointer-events: none;
}

.compare-handle__line {
  width: 100%;
  height: 100%;
  background: #ffffff;
}

.compare-handle__knob {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #244233;
  color: #ffffff;
  gap: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(22, 31, 25, 0.18);
  transform: translate(-50%, -50%);
}

.compare-chevron {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #ffffff;
  border-left: 3rpx solid #ffffff;
}

.compare-chevron--left { transform: rotate(-45deg); }
.compare-chevron--right { transform: rotate(135deg); }

.result-actions {
  display: flex;
  gap: 12rpx;
  padding: 18rpx 32rpx;
  border-bottom: 1rpx solid #d8d5ce;
  background: #fffefa;
}

.result-action {
  min-width: 0;
  min-height: 88rpx;
  flex: 1;
  padding: 0 8rpx;
  border: 1rpx solid #d0d3cc;
  border-radius: 22rpx;
  background: #f8f5f0;
  color: #424a43;
  font-size: 23rpx;
  font-weight: 600;
}

.result-detail {
  padding: 58rpx 32rpx 0;
}

.result-detail__subtitle {
  color: #626861;
  font-size: 25rpx;
}

.result-detail__features {
  margin-top: 28rpx;
  border-top: 1rpx solid #d8d5ce;
}

.result-feature {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #dedbd4;
  color: #485048;
  font-size: 25rpx;
}

.result-feature__mark {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c07048;
}

.result-price {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 26rpx 0;
  color: #666d66;
  font-size: 23rpx;
}

.result-price text:last-child {
  color: #343934;
  text-align: right;
}

.result-notice {
  margin: 30rpx 32rpx 0;
  padding: 26rpx;
  border: 1rpx solid #cbd1ca;
  border-radius: 24rpx;
  background: #edf0eb;
  color: #59655c;
  font-size: 22rpx;
  line-height: 1.6;
}

.result-booking {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 48rpx;
  padding: 34rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
  background: #202722;
  color: #ffffff;
}

.result-booking > view {
  min-width: 0;
  flex: 1;
}

.result-booking__title {
  font-size: 30rpx;
  font-weight: 700;
}

.result-booking__text {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  line-height: 1.5;
}

.result-booking .primary-button {
  width: 230rpx;
  min-height: 96rpx;
  flex: none;
  padding: 0 18rpx;
  background: #f2f4ef;
  color: #183124;
}
