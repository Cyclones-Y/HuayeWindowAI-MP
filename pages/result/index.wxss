/* 冲洗完成：从暗房回到纸面 */
.result-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
}

.result-head {
  padding: 32rpx 32rpx 28rpx;
}

.result-title {
  margin-top: 16rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.2;
}

.result-subtitle {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 前后对比舞台：标签、分隔线和手柄来自 app.wxss 共享样式 */
.compare-stage {
  position: relative;
  height: 760rpx;
  overflow: hidden;
  background: var(--paper-tint);
}

.compare-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  max-width: none;
}

.compare-before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
}

.compare-stage .compare-label {
  top: 24rpx;
}

.compare-stage .compare-divider {
  pointer-events: none;
}

/* 结果操作 */
.result-actions {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  border-bottom: 1px solid var(--line);
  background: var(--paper-surface);
}

.result-action {
  display: flex;
  min-width: 0;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 1;
  padding: 0 8rpx;
  border: 1px solid var(--line);
  border-radius: 24rpx;
  background: var(--paper-ground);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.result-action--active {
  border-color: rgba(36, 66, 51, 0.32);
  background: var(--green-tint);
  color: var(--green);
}

/* 方案信息 */
.result-detail {
  padding: 48rpx 32rpx 0;
}

.result-detail__name {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.result-detail__subtitle {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.result-detail__features {
  margin-top: 24rpx;
  border-top: 1px solid var(--line);
}

.result-feature {
  display: flex;
  min-height: 80rpx;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1px solid var(--line-soft);
  font-size: 24rpx;
  line-height: 1.5;
}

.result-feature__mark {
  width: 10rpx;
  height: 10rpx;
  flex: none;
  border-radius: 50%;
  background: var(--clay);
}

.result-price {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 0;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.result-price text:last-child {
  color: var(--ink);
  text-align: right;
}

.result-notice {
  margin: 24rpx 32rpx 48rpx;
}

/* 预约带：贴住页面底部，安全区由自身内边距承接 */
.result-booking {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: auto;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  background: var(--stage);
  color: #ffffff;
}

.result-booking__copy {
  min-width: 0;
  flex: 1;
}

.result-booking__title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.result-booking__text {
  margin-top: 6rpx;
  color: var(--stage-ink);
  font-size: 22rpx;
  line-height: 1.5;
}

.result-booking__button {
  width: auto;
  min-width: 250rpx;
  max-width: 320rpx;
  min-height: 96rpx;
  flex: none;
  padding: 0 24rpx;
  background: #e5eee7;
  color: var(--green);
  font-size: 26rpx;
}
