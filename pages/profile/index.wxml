<view class="page-shell tab-page profile-page">
  <view class="profile-intro">
    <view class="page-title">我的方案</view>
    <view class="page-subtitle">预览记录、收藏方案和量尺预约，都整理在这里。</view>
  </view>

  <view class="profile-overview" aria-role="tablist" aria-label="我的方案记录">
    <view class="profile-overview__item pressable {{activeView === 'history' ? 'profile-overview__item--active' : ''}}" data-view="history" bindtap="switchView" aria-role="tab" aria-selected="{{activeView === 'history'}}">
      <text class="profile-overview__count">{{history.length}}</text>
      <text class="profile-overview__label">效果记录</text>
    </view>
    <view class="profile-overview__item pressable {{activeView === 'favorites' ? 'profile-overview__item--active' : ''}}" data-view="favorites" bindtap="switchView" aria-role="tab" aria-selected="{{activeView === 'favorites'}}">
      <text class="profile-overview__count">{{favorites.length}}</text>
      <text class="profile-overview__label">收藏方案</text>
    </view>
    <view class="profile-overview__item pressable {{activeView === 'appointments' ? 'profile-overview__item--active' : ''}}" data-view="appointments" bindtap="switchView" aria-role="tab" aria-selected="{{activeView === 'appointments'}}">
      <text class="profile-overview__count">{{leads.length}}</text>
      <text class="profile-overview__label">预约记录</text>
    </view>
  </view>

  <view wx:if="{{activeView === 'history'}}" class="profile-content">
    <view class="profile-section-heading">
      <view class="profile-section-heading__title">最近的效果</view>
      <view class="profile-section-heading__detail">完成的门窗预览会保存在当前设备</view>
    </view>
    <view wx:if="{{history.length === 0}}" class="profile-empty">
      <view class="ic ic--lg ic--compare"></view>
      <view class="profile-empty__title">还没有效果记录</view>
      <view class="profile-empty__text">从一张现场照片开始，看看门窗改造前后的变化。</view>
      <button class="primary-button profile-empty__action" hover-class="button-hover" bindtap="startExperience">开始一次预览</button>
    </view>
    <view wx:else class="record-list">
      <view wx:for="{{history}}" wx:key="id" wx:for-item="item" class="record-row">
        <image class="record-row__image" src="{{item.thumbnail}}" mode="aspectFill" />
        <view class="record-row__copy">
          <view class="record-row__title">{{item.solutionName}}</view>
          <view class="record-row__meta"><text class="record-row__dot"></text><text>效果已生成</text></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{activeView === 'favorites'}}" class="profile-content">
    <view class="profile-section-heading">
      <view class="profile-section-heading__title">收藏的方案</view>
      <view class="profile-section-heading__detail">把想继续比较的门窗方案留在这里</view>
    </view>
    <view wx:if="{{favorites.length === 0}}" class="profile-empty">
      <view class="ic ic--lg ic--bookmark"></view>
      <view class="profile-empty__title">还没有收藏方案</view>
      <view class="profile-empty__text">浏览可施工方案，收藏后方便量尺时继续沟通。</view>
      <button class="secondary-button profile-empty__action" hover-class="button-hover" bindtap="browseSolutions">浏览门窗方案</button>
    </view>
    <view wx:else class="record-list">
      <view wx:for="{{favorites}}" wx:key="id" wx:for-item="item" class="record-row">
        <image class="record-row__image" src="{{item.thumbnail}}" mode="aspectFill" />
        <view class="record-row__copy">
          <view class="record-row__title">{{item.name}}</view>
          <view class="record-row__meta">{{item.subtitle}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="profile-content">
    <view class="profile-section-heading">
      <view class="profile-section-heading__title">量尺预约</view>
      <view class="profile-section-heading__detail">提交过的上门量尺需求会显示在这里</view>
    </view>
    <view wx:if="{{leads.length === 0}}" class="profile-empty">
      <view class="ic ic--lg ic--calendar"></view>
      <view class="profile-empty__title">还没有预约记录</view>
      <view class="profile-empty__text">先看门窗效果，方向满意后再预约上门量尺。</view>
      <button class="secondary-button profile-empty__action" hover-class="button-hover" bindtap="startExperience">先去看看效果</button>
    </view>
    <view wx:else class="record-list">
      <view wx:for="{{leads}}" wx:key="id" wx:for-item="item" class="appointment-row">
        <view class="appointment-row__top"><text class="record-row__title">{{item.community}}</text><text class="appointment-row__status">{{item.statusText}}</text></view>
        <view class="record-row__meta">{{item.contactName}} · {{item.preferredDate}} {{item.preferredTime}}</view>
      </view>
    </view>
  </view>

  <view class="privacy-section">
    <view class="privacy-section__top">
      <view class="ic ic--shield"></view>
      <view>
        <view class="privacy-section__title">隐私与数据管理</view>
        <view class="privacy-section__text">照片仅用于生成门窗效果图，预约信息仅用于联系确认上门时间。</view>
      </view>
    </view>
    <view class="privacy-section__facts">
      <view><text></text>效果记录与收藏可随时清除</view>
      <view><text></text>清除后无法恢复</view>
    </view>
    <button class="privacy-button" hover-class="privacy-button--pressed" bindtap="clearData">清除全部记录</button>
  </view>
</view>
