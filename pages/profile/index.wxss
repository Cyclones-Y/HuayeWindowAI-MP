.profile-intro {
  padding-bottom: 32rpx;
}

.profile-intro .page-title {
  margin-top: 0;
}

/* 分段概览：纸面、字重与颜色共同表达选中态 */
.profile-overview {
  display: flex;
  gap: 8rpx;
  margin-top: 0;
  padding: 8rpx;
  border-radius: 24rpx;
  background: var(--paper-tint);
}

.profile-overview__item {
  display: flex;
  min-width: 0;
  min-height: 118rpx;
  align-items: center;
  justify-content: center;
  flex: 1;
  flex-direction: column;
  border-radius: 18rpx;
  color: var(--ink-2);
  transition: transform 160ms var(--ease-out), background-color 160ms ease, color 160ms ease;
}

.profile-overview__item--active {
  background: var(--paper-surface);
  color: var(--green);
  box-shadow: 0 6rpx 18rpx rgba(38, 44, 35, 0.08);
}

.profile-overview__count {
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.profile-overview__label {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
}

.profile-content {
  min-height: 480rpx;
  padding-top: 48rpx;
}

.profile-section-heading {
  padding-bottom: 20rpx;
  border-bottom: 1px solid var(--line);
}

.profile-section-heading__title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.profile-section-heading__detail {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

/* 空状态：图标、标题、说明与下一步入口 */
.profile-empty {
  display: flex;
  min-height: 386rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 48rpx 44rpx 40rpx;
  text-align: center;
}

.profile-empty .ic {
  margin-bottom: 24rpx;
}

.profile-empty__title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.profile-empty__text {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.profile-empty__action {
  width: 320rpx;
  min-width: 320rpx;
  max-width: 320rpx;
  min-height: 96rpx;
  margin-top: 32rpx;
  font-size: 26rpx;
}

/* 记录列表 */
.record-list {
  border-bottom: 1px solid var(--line);
}

.record-row {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1px solid var(--line-soft);
}

.record-row:last-child,
.appointment-row:last-child {
  border-bottom: 0;
}

.record-row__image {
  width: 176rpx;
  height: 126rpx;
  flex: none;
  border-radius: 16rpx;
  background: var(--paper-tint);
}

.record-row__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.record-row__title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.record-row__meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.record-row__dot {
  width: 10rpx;
  height: 10rpx;
  flex: none;
  border-radius: 50%;
  background: var(--green-2);
}

.appointment-row {
  padding: 28rpx 0;
  border-bottom: 1px solid var(--line-soft);
}

.appointment-row__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.appointment-row__status {
  flex: none;
  color: var(--green);
  font-size: 22rpx;
  font-weight: 600;
}

/* 隐私与数据管理 */
.privacy-section {
  margin-top: 48rpx;
  padding: 32rpx 28rpx 24rpx;
  border: 1px solid var(--line);
  border-radius: 16rpx;
  background: var(--paper-surface);
}

.privacy-section__top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.privacy-section__title {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.privacy-section__text {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.55;
}

.privacy-section__facts {
  margin-top: 24rpx;
  padding: 16rpx 0;
  border-top: 1px solid var(--line-soft);
  border-bottom: 1px solid var(--line-soft);
}

.privacy-section__facts view {
  display: flex;
  min-height: 48rpx;
  align-items: center;
  gap: 14rpx;
  color: var(--ink-2);
  font-size: 22rpx;
}

.privacy-section__facts text {
  width: 10rpx;
  height: 10rpx;
  flex: none;
  border-radius: 50%;
  background: var(--green-2);
}

.privacy-button {
  display: flex;
  width: 100%;
  min-width: 100%;
  min-height: 88rpx;
  align-items: center;
  justify-content: flex-start;
  margin-top: 8rpx;
  padding: 0;
  background: transparent;
  color: var(--error);
  font-size: 24rpx;
  font-weight: 600;
  transition: opacity 160ms ease;
}

.privacy-button--pressed {
  opacity: 0.55;
}
