.profile-head {
  display: grid;
  grid-template-columns: 84rpx 1fr;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 30rpx;
}

.profile-avatar {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #1f5637;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 800;
}

.profile-note {
  margin-top: 7rpx;
  color: #787c76;
  font-size: 21rpx;
}

.profile-status {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #737a74;
  font-size: 20rpx;
}

.profile-status text {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1f5637;
}

.profile-overview {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-bottom: 42rpx;
  padding: 28rpx 0;
  border-top: 1rpx solid #d7d9d3;
  border-bottom: 1rpx solid #d7d9d3;
}

.profile-overview view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border-right: 1rpx solid #d7d9d3;
  text-align: center;
}

.profile-overview view:last-child { border-right: 0; }

.profile-overview text:first-child {
  color: #1f5637;
  font-size: 36rpx;
  font-weight: 800;
}

.profile-overview text:last-child {
  color: #717771;
  font-size: 20rpx;
}

.profile-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-bottom: 1rpx solid #d6d8d2;
}

.profile-tab {
  position: relative;
  min-height: 76rpx;
  color: #777b75;
  font-size: 24rpx;
  line-height: 76rpx;
  text-align: center;
}

.profile-tab--active {
  color: #1f5637;
  font-weight: 700;
}

.profile-tab--active::after {
  position: absolute;
  right: 18rpx;
  bottom: -1rpx;
  left: 18rpx;
  height: 4rpx;
  background: #1f5637;
  content: '';
}

.profile-content {
  min-height: 430rpx;
}

.empty-action {
  width: 220rpx;
  min-height: 76rpx;
  margin-top: 28rpx;
}

.record-list {
  border-top: 1rpx solid #e0e1db;
}

.record-row {
  display: grid;
  grid-template-columns: 152rpx 1fr;
  gap: 22rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e0e1db;
}

.record-row__image {
  width: 152rpx;
  height: 112rpx;
  border-radius: 6rpx;
  background: #e4e5df;
}

.record-row__copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
}

.record-row__title {
  font-size: 27rpx;
  font-weight: 700;
}

.record-row__meta {
  margin-top: 10rpx;
  color: #767a74;
  font-size: 22rpx;
  line-height: 1.45;
}

.appointment-row {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #e0e1db;
}

.appointment-row__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.appointment-row__status {
  color: #1f5637;
  font-size: 21rpx;
  font-weight: 650;
}

.privacy-section {
  margin-top: 68rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #d9dad4;
}

.privacy-section__title {
  font-size: 28rpx;
  font-weight: 700;
}

.privacy-section__text {
  margin-top: 12rpx;
  color: #777b75;
  font-size: 23rpx;
  line-height: 1.55;
}

.privacy-button {
  min-height: 72rpx;
  margin-top: 22rpx;
  padding: 0;
  background: transparent;
  color: #934139;
  font-size: 23rpx;
  font-weight: 600;
  text-align: left;
}
