.profile-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 32rpx;
}

.profile-avatar {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  flex: none;
  border-radius: 28rpx;
  background: #244233;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 750;
}

.profile-head__copy {
  min-width: 0;
  flex: 1;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
}

.profile-note {
  margin-top: 7rpx;
  color: #687069;
  font-size: 22rpx;
}

.profile-status {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 10rpx;
  color: #687069;
  font-size: 21rpx;
}

.profile-status text {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #244233;
}

.profile-overview {
  display: flex;
  margin-bottom: 44rpx;
  padding: 30rpx 0;
  border-top: 1rpx solid #d8d5ce;
  border-bottom: 1rpx solid #d8d5ce;
}

.profile-overview view {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  border-right: 1rpx solid #d8d5ce;
  text-align: center;
}

.profile-overview view:last-child { border-right: 0; }

.profile-overview text:first-child {
  color: #244233;
  font-size: 38rpx;
  font-weight: 750;
}

.profile-overview text:last-child {
  color: #656b64;
  font-size: 21rpx;
}

.profile-tabs {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: #e7e6df;
}

.profile-tab {
  min-width: 0;
  min-height: 88rpx;
  flex: 1;
  border-radius: 20rpx;
  color: #5f665f;
  font-size: 23rpx;
  line-height: 88rpx;
  text-align: center;
  transition: transform 160ms ease, background-color 160ms ease;
}

.profile-tab--active {
  background: #fffefa;
  color: #244233;
  font-weight: 650;
  box-shadow: 0 4rpx 14rpx rgba(38, 44, 35, 0.08);
}

.profile-content {
  min-height: 430rpx;
  margin-top: 22rpx;
}

.empty-action {
  width: 240rpx;
  margin-top: 28rpx;
}

.record-list {
  border-top: 1rpx solid #dedbd4;
}

.record-row {
  display: flex;
  gap: 22rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #dedbd4;
}

.record-row__image {
  width: 160rpx;
  height: 118rpx;
  flex: none;
  border-radius: 16rpx;
  background: #e4e4dc;
}

.record-row__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.record-row__title {
  font-size: 28rpx;
  font-weight: 650;
}

.record-row__meta {
  margin-top: 10rpx;
  color: #656b64;
  font-size: 23rpx;
  line-height: 1.45;
}

.appointment-row {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #dedbd4;
}

.appointment-row__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.appointment-row__status {
  color: #244233;
  font-size: 22rpx;
  font-weight: 650;
}

.privacy-section {
  margin-top: 70rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #d8d5ce;
}

.privacy-section__title {
  font-size: 30rpx;
  font-weight: 650;
}

.privacy-section__text {
  margin-top: 12rpx;
  color: #656b64;
  font-size: 24rpx;
  line-height: 1.6;
}

.privacy-button {
  min-height: 88rpx;
  margin-top: 18rpx;
  padding: 0;
  background: transparent;
  color: #934139;
  font-size: 24rpx;
  font-weight: 600;
  text-align: left;
}
