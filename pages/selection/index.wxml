<view class="selection-page with-action-bar">
  <view class="selection-head">
    <view class="flow-step selection-progress"><text>效果预览</text><text>02 / 04</text></view>
    <view class="selection-title">框住需要更换的门窗</view>
    <view class="selection-hint {{hintError ? 'selection-hint--error' : ''}}">{{hintText}}</view>
  </view>

  <view class="selection-stage">
    <image class="selection-photo" src="{{photoPath}}" mode="widthFix" bindload="onImageLoad" />
    <view wx:if="{{stageReady}}" class="selection-box" style="left: {{box.left}}px; top: {{box.top}}px; width: {{box.width}}px; height: {{box.height}}px;" data-mode="move" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd">
      <view class="selection-box__grid selection-box__grid--v1"></view>
      <view class="selection-box__grid selection-box__grid--v2"></view>
      <view class="selection-box__grid selection-box__grid--h1"></view>
      <view class="selection-box__grid selection-box__grid--h2"></view>
      <view class="selection-handle-hit selection-handle-hit--nw" data-mode="nw" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd"><view class="selection-handle"></view></view>
      <view class="selection-handle-hit selection-handle-hit--ne" data-mode="ne" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd"><view class="selection-handle"></view></view>
      <view class="selection-handle-hit selection-handle-hit--sw" data-mode="sw" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd"><view class="selection-handle"></view></view>
      <view class="selection-handle-hit selection-handle-hit--se" data-mode="se" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd"><view class="selection-handle"></view></view>
    </view>
  </view>

  <view class="selection-footnote">选框外的墙体、家具和视角会保持不变。</view>

  <view class="action-bar selection-actions">
    <button class="quiet-button" hover-class="button-hover" bindtap="resetSelection">重置</button>
    <button class="primary-button" hover-class="button-hover" bindtap="confirmSelection">选好了</button>
  </view>
</view>
