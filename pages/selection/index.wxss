/* 暗房：从框选开始进入深色工作台，生成页延续，结果页再回到纸面。 */
.selection-page {
  min-height: 100vh;
  background: var(--stage);
  color: #ffffff;
}

.selection-head {
  padding: 32rpx 32rpx 24rpx;
}

.selection-progress {
  border-bottom-color: var(--stage-line);
  color: var(--stage-ink);
}

.selection-progress text:last-child {
  color: var(--stage-accent);
}

.selection-title {
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.2;
}

.selection-hint {
  min-height: 70rpx;
  margin-top: 12rpx;
  color: var(--stage-ink);
  font-size: 24rpx;
  line-height: 1.55;
}

.selection-hint--error {
  color: #ffb4aa;
}

.selection-stage {
  position: relative;
  width: 100%;
  max-height: 900rpx;
  overflow: hidden;
  background: #101310;
}

.selection-photo {
  display: block;
  width: 100%;
}

.selection-box {
  position: absolute;
  border: 4rpx solid var(--stage-accent);
  border-radius: 8rpx;
  box-shadow: 0 0 0 1600rpx rgba(10, 13, 11, 0.56);
}

.selection-box__grid {
  position: absolute;
  background: rgba(255, 255, 255, 0.34);
}

.selection-box__grid--v1,
.selection-box__grid--v2 {
  top: 0;
  bottom: 0;
  width: 1px;
}

.selection-box__grid--v1 { left: 33.333%; }
.selection-box__grid--v2 { left: 66.666%; }

.selection-box__grid--h1,
.selection-box__grid--h2 {
  right: 0;
  left: 0;
  height: 1px;
}

.selection-box__grid--h1 { top: 33.333%; }
.selection-box__grid--h2 { top: 66.666%; }

.selection-handle-hit {
  position: absolute;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
}

.selection-handle {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.35);
}

.selection-handle-hit--nw { top: -50rpx; left: -50rpx; }
.selection-handle-hit--ne { top: -50rpx; right: -50rpx; }
.selection-handle-hit--sw { bottom: -50rpx; left: -50rpx; }
.selection-handle-hit--se { right: -50rpx; bottom: -50rpx; }

.selection-footnote {
  padding: 28rpx 32rpx;
  color: var(--stage-ink);
  font-size: 22rpx;
  line-height: 1.55;
}

.selection-actions {
  border-top-color: var(--stage-line);
  background: var(--stage);
}

.selection-actions .quiet-button {
  background: var(--stage-2);
  color: #ffffff;
}

.selection-actions .primary-button {
  background: #e5eee7;
  color: var(--green);
}
