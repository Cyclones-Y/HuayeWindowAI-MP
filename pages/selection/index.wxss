.selection-page {
  min-height: 100vh;
  background: #1f2521;
  color: #ffffff;
}

.selection-head {
  padding: 32rpx 32rpx 28rpx;
}

.selection-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #424a44;
  color: rgba(255, 255, 255, 0.64);
  font-size: 22rpx;
  font-weight: 600;
}

.selection-progress text:last-child {
  color: #b9d1c1;
}

.selection-title {
  font-size: 42rpx;
  font-weight: 700;
}

.selection-hint {
  min-height: 70rpx;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.55;
}

.selection-hint--error {
  color: #ffb4aa;
}

.selection-stage {
  position: relative;
  width: 100%;
  max-height: 900rpx;
  overflow: hidden;
  background: #101310;
}

.selection-photo {
  display: block;
  width: 100%;
}

.selection-box {
  position: absolute;
  border: 4rpx solid #b7d7c0;
  border-radius: 12rpx;
  box-shadow: 0 0 0 1600rpx rgba(10, 13, 11, 0.56);
}

.selection-box__grid {
  position: absolute;
  background: rgba(255, 255, 255, 0.34);
}

.selection-box__grid--v1,
.selection-box__grid--v2 {
  top: 0;
  bottom: 0;
  width: 1rpx;
}

.selection-box__grid--v1 { left: 33.333%; }
.selection-box__grid--v2 { left: 66.666%; }

.selection-box__grid--h1,
.selection-box__grid--h2 {
  right: 0;
  left: 0;
  height: 1rpx;
}

.selection-box__grid--h1 { top: 33.333%; }
.selection-box__grid--h2 { top: 66.666%; }

.selection-handle-hit {
  position: absolute;
  display: flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
}

.selection-handle {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #244233;
}

.selection-handle-hit--nw { top: -50rpx; left: -50rpx; }
.selection-handle-hit--ne { top: -50rpx; right: -50rpx; }
.selection-handle-hit--sw { bottom: -50rpx; left: -50rpx; }
.selection-handle-hit--se { right: -50rpx; bottom: -50rpx; }

.selection-footnote {
  padding: 30rpx 32rpx;
  color: rgba(255, 255, 255, 0.64);
  font-size: 22rpx;
  line-height: 1.55;
}

.selection-actions {
  display: flex;
  gap: 16rpx;
  border-color: #424842;
  background: #1f2521;
}

.selection-actions button {
  width: auto;
}

.selection-actions .quiet-button {
  flex: 0.72;
  background: #384039;
  color: #ffffff;
}

.selection-actions .primary-button {
  flex: 1.28;
  background: #e5eee7;
  color: #183124;
}
