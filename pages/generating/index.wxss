.generating-page {
  min-height: 100vh;
  padding: 48rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #f8f5f0;
}

.generation-state {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #596159;
  font-size: 23rpx;
  font-weight: 600;
}

.generation-state text {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #244233;
}

.generating-top {
  max-width: 650rpx;
}

.generating-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.generating-subtitle {
  margin-top: 14rpx;
  color: #626861;
  font-size: 25rpx;
  line-height: 1.6;
}

.generation-visual {
  position: relative;
  height: 660rpx;
  margin-top: 44rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #e4e4dc;
}

.generation-visual__image,
.generation-visual__mask,
.generation-visual__scan {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.generation-visual__mask {
  background: rgba(21, 28, 23, 0.18);
}

.generation-visual__scan {
  z-index: 1;
  width: 3rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 0 26rpx rgba(255, 255, 255, 0.72);
  animation: scan 2.4s ease-in-out infinite alternate;
}

@keyframes scan {
  from { transform: translateX(70rpx); }
  to { transform: translateX(620rpx); }
}

.progress-block {
  margin-top: 40rpx;
}

.progress-block__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
  font-weight: 650;
}

.progress-track {
  height: 12rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #dfe1da;
}

.progress-value {
  width: 100%;
  height: 100%;
  transform-origin: left center;
  border-radius: 6rpx;
  background: #244233;
  transition: transform 420ms ease;
}

.progress-steps {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  color: #5f665f;
  font-size: 21rpx;
}

.progress-step {
  flex: 1;
}

.progress-step:nth-child(2) { text-align: center; }
.progress-step:nth-child(3) { text-align: right; }
.progress-step--done { color: #244233; }

.failure-panel {
  margin-top: 48rpx;
  padding: 48rpx 32rpx;
  border: 1rpx solid #d7c5c1;
  border-radius: 24rpx;
  background: #f6ece9;
}

.failure-panel__mark {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #a6433b;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 750;
}

.failure-panel__title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.failure-panel__text {
  margin-top: 10rpx;
  color: #6d615e;
  font-size: 24rpx;
}

.retry-generation {
  width: 100%;
  margin-top: 36rpx;
}

@media (prefers-reduced-motion: reduce) {
  .generation-visual__scan {
    right: 24rpx;
    left: auto;
    animation: none;
  }

  .progress-value {
    transition: none;
  }
}
