/* 暗房第二幕：延续框选页的深色工作台，结果页才回到纸面。 */
.generating-page {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  background: var(--stage);
  color: #ffffff;
}

.generating-top {
  max-width: 650rpx;
}

.generating-state {
  color: var(--stage-ink);
}

.generating-state .status-line__dot {
  background: var(--stage-accent);
  animation: state-pulse 1.6s ease-in-out infinite;
}

.generating-state--failed .status-line__dot {
  background: #e08a80;
  animation: none;
}

@keyframes state-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.45; transform: scale(0.8); }
}

.generating-title {
  margin-top: 20rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.2;
}

.generating-subtitle {
  margin-top: 12rpx;
  color: var(--stage-ink);
  font-size: 24rpx;
  line-height: 1.6;
}

/* 用户照片与选框 */
.generation-stage {
  position: relative;
  width: 100%;
  height: 720rpx;
  margin: 36rpx auto 0;
  overflow: hidden;
  border-radius: 16rpx;
  background: #101310;
}

.generation-stage__photo {
  display: block;
  width: 100%;
  height: 100%;
}

.generation-stage__box {
  position: absolute;
  overflow: hidden;
  border: 3rpx solid var(--stage-accent);
  border-radius: 6rpx;
  box-shadow: 0 0 0 1000rpx rgba(10, 13, 11, 0.5), 0 0 28rpx rgba(183, 215, 192, 0.35);
}

.generation-stage__scan {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 3rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 0 24rpx rgba(255, 255, 255, 0.7), 0 0 60rpx rgba(183, 215, 192, 0.5);
  animation: scan 2.2s ease-in-out infinite alternate;
}

@keyframes scan {
  from { left: 2%; }
  to { left: 98%; }
}

.generation-stage__solution {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  display: flex;
  max-width: calc(100% - 32rpx);
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 18rpx 10rpx 10rpx;
  border-radius: 14rpx;
  background: rgba(31, 37, 33, 0.86);
}

.generation-stage__thumb {
  width: 72rpx;
  height: 54rpx;
  flex: none;
  border-radius: 8rpx;
  background: var(--stage-2);
}

.generation-stage__solution-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 2rpx;
}

.generation-stage__solution-label {
  color: var(--stage-ink);
  font-size: 22rpx;
  line-height: 1.3;
}

.generation-stage__solution-name {
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 进度 */
.progress-block {
  margin-top: 36rpx;
}

.progress-block__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.progress-block__percent {
  font-variant-numeric: tabular-nums;
}

.progress-track {
  height: 10rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: 5rpx;
  background: var(--stage-line);
}

.progress-value {
  width: 100%;
  height: 100%;
  transform-origin: left center;
  border-radius: 5rpx;
  background: var(--stage-accent);
  transition: transform 420ms var(--ease-out);
}

.progress-value--failed {
  background: #e08a80;
}

.progress-steps {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  color: var(--stage-ink);
  font-size: 22rpx;
  line-height: 1.45;
  gap: 12rpx;
}

.progress-step {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.progress-step--done { color: #ffffff; font-weight: 600; }
.stage-segment { height: 12rpx; margin-bottom: 16rpx; border-radius: 8rpx; background: var(--stage-line); }
.progress-step--done .stage-segment { background: var(--stage-accent); }
.progress-step--active { color: #ffffff; }
.progress-step--active .stage-segment { background: var(--stage-accent); animation: state-pulse 1.6s ease-in-out infinite; }
.progress-step--failed .stage-segment { background: #e08a80; }
@media (prefers-reduced-motion: reduce) { .progress-step--active .stage-segment { animation: none; } }

/* 失败面板 */
.failure-panel {
  margin-top: 36rpx;
  padding: 44rpx 32rpx;
  border: 1px solid var(--stage-line);
  border-radius: 24rpx;
  background: var(--stage-2);
}

.failure-panel__mark {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--error);
}

.failure-panel__title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.failure-panel__text {
  margin-top: 10rpx;
  color: var(--stage-ink);
  font-size: 24rpx;
  line-height: 1.6;
}

.failure-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 36rpx;
}

.failure-actions button {
  width: auto;
  min-width: 0;
}

.failure-actions .quiet-button {
  flex: 0.72;
  background: var(--stage-2);
  color: #ffffff;
}

.failure-actions .primary-button {
  flex: 1.28;
  background: #e5eee7;
  color: var(--green);
}

@media (prefers-reduced-motion: reduce) {
  .generation-stage__scan {
    left: 50%;
    animation: none;
  }

  .generating-state .status-line__dot {
    animation: none;
  }

  .progress-value {
    transition: none;
  }
}
