<view class="generating-page">
  <view class="generating-top">
    <view class="generation-state"><text></text>{{status === 'FAILED' ? '任务已暂停' : '正在生成门窗预览'}}</view>
    <view class="generating-title">{{status === 'FAILED' ? '这次没有生成完成' : '正在准备门窗效果'}}</view>
    <view class="generating-subtitle">{{status === 'FAILED' ? errorMessage : '正在匹配所选窗型、颜色和玻璃配置。'}}</view>
  </view>

  <view wx:if="{{status !== 'FAILED'}}" class="generation-visual">
    <image class="generation-visual__image" src="{{solution.thumbnail}}" mode="aspectFill" />
    <view class="generation-visual__scan"></view>
    <view class="generation-visual__mask"></view>
  </view>

  <view wx:else class="failure-panel">
    <view class="failure-panel__mark">!</view>
    <view class="failure-panel__title">可以重新生成</view>
    <view class="failure-panel__text">本次失败不会产生预约记录。</view>
  </view>

  <view class="progress-block">
    <view class="progress-block__top">
      <text>{{stageText}}</text>
      <text>{{progress}}%</text>
    </view>
    <view class="progress-track"><view class="progress-value" style="transform: scaleX({{progress / 100}});"></view></view>
    <view class="progress-steps">
      <view class="progress-step {{progress >= 18 ? 'progress-step--done' : ''}}">校验方案</view>
      <view class="progress-step {{progress >= 46 ? 'progress-step--done' : ''}}">保持结构</view>
      <view class="progress-step {{progress >= 78 ? 'progress-step--done' : ''}}">替换门窗</view>
    </view>
  </view>

  <button wx:if="{{status === 'FAILED'}}" class="primary-button retry-generation" bindtap="retryTask">再试一次</button>
</view>
