.appointment-notice {
  margin-top: 32rpx;
}

.appointment-form {
  margin-top: 40rpx;
}

.submit-button {
  width: 100%;
  margin-top: 8rpx;
}

.privacy-copy {
  margin-top: 20rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

/* 成功页 */
.appointment-success {
  min-height: 100vh;
  padding: 140rpx 48rpx calc(72rpx + env(safe-area-inset-bottom));
  background: var(--paper-ground);
}

.appointment-success__mark {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: var(--green);
}

.appointment-success__mark .ic {
  width: 56rpx;
  height: 56rpx;
}

.appointment-success__title {
  margin-top: 40rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.2;
}

.appointment-success__text {
  max-width: 600rpx;
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.65;
}

.appointment-success button {
  width: 100%;
  margin-top: 40rpx;
}

.appointment-success .secondary-button {
  margin-top: 16rpx;
}
