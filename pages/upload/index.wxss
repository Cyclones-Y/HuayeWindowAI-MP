.selected-note {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  border: 1px solid rgba(36, 66, 51, 0.16);
  border-radius: 24rpx;
  background: var(--green-soft);
  color: var(--ink-2);
  font-size: 24rpx;
}

.selected-note__value {
  color: var(--green);
  font-weight: 600;
  text-align: right;
}

/* 拍摄示意：图片加取景四角 */
.camera-guide {
  position: relative;
  height: 520rpx;
  margin-top: 32rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: var(--paper-tint);
}

.camera-guide__image {
  width: 100%;
  height: 100%;
}

.camera-guide__frame {
  position: absolute;
  top: 64rpx;
  right: 64rpx;
  bottom: 96rpx;
  left: 64rpx;
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: 8rpx;
  box-shadow: 0 0 0 1000rpx rgba(24, 30, 26, 0.28);
}

.camera-guide__corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #ffffff;
}

.camera-guide__corner--nw { top: -2rpx; left: -2rpx; border-right: 0; border-bottom: 0; border-top-left-radius: 8rpx; }
.camera-guide__corner--ne { top: -2rpx; right: -2rpx; border-left: 0; border-bottom: 0; border-top-right-radius: 8rpx; }
.camera-guide__corner--sw { bottom: -2rpx; left: -2rpx; border-right: 0; border-top: 0; border-bottom-left-radius: 8rpx; }
.camera-guide__corner--se { right: -2rpx; bottom: -2rpx; border-left: 0; border-top: 0; border-bottom-right-radius: 8rpx; }

.camera-guide__label {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}

/* 拍摄提示 */
.shoot-tips {
  margin-top: 32rpx;
  border-top: 1px solid var(--line);
}

.shoot-tip {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1px solid var(--line-soft);
  font-size: 24rpx;
  line-height: 1.5;
}

.shoot-tip__index {
  width: 56rpx;
  flex: none;
  color: var(--clay);
  font-size: 22rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.upload-privacy {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 32rpx;
}

/* 上传状态沿用既有间距和按钮尺寸；服务端处理时保持 100%，不虚构处理进度。 */
.upload-status { margin-top: 32rpx; }
.upload-status__heading { display: flex; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; font-size: 26rpx; }
.upload-status__cancel { margin-top: 24rpx; }
.upload-error { margin-top: 24rpx; color: #A6433B; font-size: 26rpx; line-height: 1.6; }
