.selected-note {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 30rpx;
  padding: 0 24rpx;
  border: 1rpx solid #cbd1ca;
  border-radius: 24rpx;
  background: #edf0eb;
  color: #626961;
  font-size: 23rpx;
}

.selected-note__value {
  color: #244233;
  font-weight: 650;
  text-align: right;
}

.camera-guide {
  position: relative;
  height: 560rpx;
  margin-top: 38rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #e4e4dc;
}

.camera-guide__image {
  width: 100%;
  height: 100%;
}

.camera-guide__frame {
  position: absolute;
  top: 76rpx;
  right: 70rpx;
  bottom: 76rpx;
  left: 70rpx;
  border: 3rpx solid #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 0 0 1000rpx rgba(24, 30, 26, 0.26);
}

.camera-guide__label {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  left: 24rpx;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
  text-align: center;
}

.shoot-tips {
  margin-top: 36rpx;
  border-top: 1rpx solid #d8d5ce;
}

.shoot-tip {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #dedbd4;
  color: #4d544d;
  font-size: 24rpx;
}

.shoot-tip__index {
  width: 58rpx;
  flex: none;
  color: #c07048;
  font-weight: 700;
}

.privacy-note {
  margin-top: 34rpx;
  padding: 26rpx 0;
  border-top: 1rpx solid #d8d5ce;
  border-bottom: 1rpx solid #d8d5ce;
}

.privacy-note__title {
  font-size: 26rpx;
  font-weight: 650;
}

.privacy-note__text {
  margin-top: 8rpx;
  color: #656b64;
  font-size: 23rpx;
  line-height: 1.55;
}

.upload-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 34rpx;
}

.upload-actions button {
  width: auto;
  min-width: 0;
  flex: 1;
}
