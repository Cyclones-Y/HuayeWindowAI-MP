.selected-note {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #285c3a;
  background: #edf2ed;
  color: #6d716c;
  font-size: 22rpx;
}

.selected-note__value {
  color: #285c3a;
  font-weight: 700;
}

.camera-guide {
  position: relative;
  height: 560rpx;
  margin-top: 36rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #dfe1dc;
}

.camera-guide__image {
  width: 100%;
  height: 100%;
}

.camera-guide__frame {
  position: absolute;
  top: 82rpx;
  right: 76rpx;
  bottom: 82rpx;
  left: 76rpx;
  border: 3rpx solid #ffffff;
  border-radius: 6rpx;
  box-shadow: 0 0 0 1000rpx rgba(24, 30, 26, 0.28);
}

.camera-guide__label {
  position: absolute;
  right: 0;
  bottom: 22rpx;
  left: 0;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.shoot-tips {
  margin-top: 34rpx;
  border-top: 1rpx solid #dcded7;
}

.shoot-tip {
  display: grid;
  grid-template-columns: 64rpx 1fr;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e2e3dd;
  color: #555a55;
  font-size: 24rpx;
}

.shoot-tip__index {
  color: #285c3a;
  font-weight: 700;
}

.privacy-note {
  margin-top: 32rpx;
  padding: 24rpx;
  border: 1rpx solid #dedfd9;
  border-radius: 8rpx;
  background: #ffffff;
}

.privacy-note__title {
  font-size: 25rpx;
  font-weight: 700;
}

.privacy-note__text {
  margin-top: 8rpx;
  color: #747873;
  font-size: 22rpx;
  line-height: 1.55;
}

.upload-actions {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 16rpx;
  margin-top: 38rpx;
}

.upload-actions button {
  width: 100%;
  min-width: 0;
}
