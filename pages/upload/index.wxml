<view class="page-shell with-action-bar upload-page">
  <view class="flow-step"><text>效果预览</text><text>01 / 04</text></view>
  <view class="page-title"><text>先拍下你家</text><text>现在的门窗</text></view>
  <view class="page-subtitle">正对窗户拍摄，保留完整窗框和周边墙面。</view>

  <view wx:if="{{selectedSolutionName}}" class="selected-note">
    <text>已选方案</text>
    <text class="selected-note__value">{{selectedSolutionName}}</text>
  </view>

  <view class="camera-guide">
    <image class="camera-guide__image" src="/assets/generated/home-hero-mobile.jpg" mode="aspectFill" />
    <view class="camera-guide__frame">
      <view class="camera-guide__corner camera-guide__corner--nw"></view>
      <view class="camera-guide__corner camera-guide__corner--ne"></view>
      <view class="camera-guide__corner camera-guide__corner--sw"></view>
      <view class="camera-guide__corner camera-guide__corner--se"></view>
    </view>
    <view class="camera-guide__label">拍摄示意：完整窗框放在画面中央</view>
  </view>

  <view class="shoot-tips">
    <view class="shoot-tip"><text class="shoot-tip__index">01</text><text>正对窗户，减少透视变形</text></view>
    <view class="shoot-tip"><text class="shoot-tip__index">02</text><text>打开窗帘，保持房间明亮</text></view>
    <view class="shoot-tip"><text class="shoot-tip__index">03</text><text>不要拍到家人和隐私物品</text></view>
  </view>

  <view class="notice upload-privacy">
    <view class="ic ic--shield"></view>
    <view>
      <view class="notice__title">照片将上传并私密保存</view>
      <view class="notice__text">上传后用于门窗方案预览，可在“我的”中清理本设备上传的照片。画面中请不要包含家人和隐私物品。</view>
    </view>
  </view>

  <view wx:if="{{uploading}}" class="upload-status">
    <view class="upload-status__heading"><text>{{uploadStage}}</text><text>{{uploadProgress}}%</text></view>
    <progress percent="{{uploadProgress}}" stroke-width="4" activeColor="#244233" backgroundColor="#E8E5DC" />
    <button class="secondary-button upload-status__cancel" bindtap="cancelUpload">取消上传</button>
  </view>
  <view wx:if="{{uploadError}}" class="upload-error">{{uploadError}}</view>

  <view class="action-bar">
    <button class="secondary-button" hover-class="button-hover" disabled="{{choosing}}" bindtap="chooseFromAlbum">从相册选择</button>
    <button class="primary-button" hover-class="button-hover" loading="{{choosing}}" disabled="{{choosing}}" bindtap="chooseFromCamera"><view class="ic ic--sm ic--camera ic--white"></view><text>拍一张</text></button>
  </view>
</view>
