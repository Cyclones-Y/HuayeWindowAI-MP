.need-scroll {
  width: calc(100% + 32rpx);
  margin-top: 40rpx;
}

.need-row {
  display: flex;
  gap: 12rpx;
  padding-right: 32rpx;
}

.need-chip {
  flex: none;
  min-height: 88rpx;
  padding: 0 28rpx;
  border: 1rpx solid #cfd2cb;
  border-radius: 24rpx;
  background: #fffefa;
  color: #4f564f;
  font-size: 24rpx;
  line-height: 88rpx;
  transition: transform 160ms ease, background-color 160ms ease;
}

.need-chip--active {
  border-color: #244233;
  background: #244233;
  color: #ffffff;
  font-weight: 650;
}

.select-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 34rpx;
}

.select-skeleton {
  height: 520rpx;
  border-radius: 16rpx;
}

.retry-button {
  width: 260rpx;
  margin-top: 28rpx;
}
