.tabbar-shell {
  position: fixed;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 1000;
}

.tabbar {
  display: flex;
  height: 128rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 46rpx;
  background: rgba(246, 241, 231, 0.86);
  box-shadow: 0 22rpx 56rpx rgba(25, 38, 31, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
}

.tabbar__item {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6rpx;
  border-radius: 34rpx;
  color: #757a74;
  transition: transform 160ms ease, background-color 180ms ease, color 180ms ease;
}

.tabbar__item:active { transform: scale(0.97); }

.tabbar__item--active {
  background: rgba(255, 255, 255, 0.66);
  color: #22322a;
  box-shadow: 0 8rpx 22rpx rgba(34, 50, 42, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.tabbar__icon { width: 42rpx; height: 42rpx; }
.tabbar__label { font-size: 19rpx; font-weight: 700; }
