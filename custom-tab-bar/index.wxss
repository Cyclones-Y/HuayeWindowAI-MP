.tabbar-shell {
  position: fixed;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 1000;
}

.tabbar {
  display: flex;
  height: 128rpx;
  padding: 10rpx;
  border: 1px solid var(--line);
  border-radius: 36rpx;
  background: rgba(255, 254, 250, 0.96);
  box-shadow: 0 18rpx 44rpx rgba(25, 38, 31, 0.16);
}

.tabbar__item {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6rpx;
  border-radius: 28rpx;
  color: var(--ink-2);
  transition: transform 160ms var(--ease-out), background-color 180ms ease, color 180ms ease;
}

.tabbar__item:active {
  transform: scale(0.97);
}

.tabbar__item--active {
  background: var(--green-tint);
  color: var(--green);
}

.tabbar__icon {
  width: 42rpx;
  height: 42rpx;
}

.tabbar__label {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}
