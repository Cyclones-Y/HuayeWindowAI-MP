/* ------------------------------------------------------------
 * 设计令牌：与 DESIGN.md 前言保持一致。页面样式只引用变量，不再写散落的十六进制色值。
 * ------------------------------------------------------------ */
page {
  --paper-ground: #f8f5f0;
  --paper-surface: #fffefa;
  --paper-muted: #efebe3;
  --paper-tint: #e8e5dc;

  --ink: #262c23;
  --ink-2: #5a615a;
  --ink-placeholder: #666c65;

  --line: #d8d5ce;
  --line-soft: #e4e1da;

  --green: #244233;
  --green-2: #375345;
  --green-tint: #e3e8e2;
  --green-soft: #eef1ec;

  --clay: #c07048;
  --clay-tint: #f1e1da;

  --error: #a6433b;
  --error-tint: #f6ece9;

  --stage: #1f2521;
  --stage-2: #2a312c;
  --stage-line: #3a423c;
  --stage-ink: rgba(255, 255, 255, 0.72);
  --stage-accent: #b7d7c0;

  --font-sans: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-serif: "Songti SC", STSong, "Noto Serif CJK SC", "Source Han Serif SC", serif;

  --ease-out: cubic-bezier(0.2, 0.8, 0.2, 1);

  min-height: 100%;
  background: var(--paper-ground);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 26rpx;
  line-height: 1.6;
  letter-spacing: 0;
}

view,
text,
image,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  overflow: hidden;
  border-radius: 28rpx;
  font-family: var(--font-sans);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

button::after {
  border: 0;
}

/* ------------------------------------------------------------
 * 字体层级：只使用 22 / 24 / 26 / 28 / 34 / 50 / 56 七档字号，400 / 600 / 700 三档字重。
 * ------------------------------------------------------------ */
.t-display {
  font-family: var(--font-serif);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.3;
}

.t-headline {
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.2;
}

.t-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.t-subtitle {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.t-body {
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.6;
}

.t-body-strong {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.t-label {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.45;
}

.t-caption {
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.5;
}

.t-muted {
  color: var(--ink-2);
}

.t-serif {
  font-family: var(--font-serif);
}

/* ------------------------------------------------------------
 * 页面骨架
 * ------------------------------------------------------------ */
.page-shell {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));
}

.with-action-bar {
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
}

.tab-page {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.flow-step {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid var(--line);
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.45;
}

.flow-step text:last-child {
  color: var(--green);
  font-variant-numeric: tabular-nums;
}

.page-context {
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.45;
}

.page-title {
  margin-top: 16rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-title text {
  display: block;
}

.page-subtitle {
  max-width: 640rpx;
  margin-top: 16rpx;
  color: var(--ink-2);
  font-size: 26rpx;
  line-height: 1.6;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.section-heading__title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-heading__description {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.5;
}

.section-heading__meta {
  color: var(--ink-2);
  font-size: 22rpx;
}

.section-link {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 6rpx;
  flex: none;
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 600;
}

.section-link::after {
  width: 10rpx;
  height: 10rpx;
  margin-left: 4rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.divider {
  height: 1px;
  background: var(--line);
}

/* ------------------------------------------------------------
 * 按钮
 * ------------------------------------------------------------ */
.primary-button,
.secondary-button,
.quiet-button {
  display: flex;
  width: 100%;
  min-width: 100%;
  min-height: 104rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 0 32rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0;
  transition: transform 160ms var(--ease-out), opacity 160ms ease;
}

.primary-button {
  background: var(--green);
  color: #ffffff;
}

.secondary-button {
  border: 1px solid var(--line);
  background: var(--paper-surface);
  color: var(--green);
}

.quiet-button {
  background: var(--paper-tint);
  color: var(--ink);
}

.primary-button:active,
.secondary-button:active,
.quiet-button:active,
.pressable:active {
  transform: scale(0.985);
  opacity: 0.9;
}

.button-hover {
  transform: scale(0.985);
  opacity: 0.9;
}

button[disabled] {
  opacity: 0.42;
}

.text-button {
  display: inline-flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 20rpx;
  background: transparent;
  color: var(--green-2);
  font-size: 24rpx;
  font-weight: 600;
  transition: opacity 160ms ease;
}

.text-button--pressed {
  opacity: 0.55;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1px solid var(--line);
  background: var(--paper-ground);
}

.action-bar button {
  width: auto;
  min-width: 0;
  flex: 1;
}

.action-bar .quiet-button,
.action-bar .secondary-button {
  flex: 0.72;
}

.action-bar .primary-button {
  flex: 1.28;
}

.action-bar button:only-child {
  flex: 1;
}

/* ------------------------------------------------------------
 * 状态标签与提示
 * ------------------------------------------------------------ */
.notice {
  padding: 26rpx 28rpx;
  border: 1px solid rgba(36, 66, 51, 0.16);
  border-radius: 24rpx;
  background: var(--green-soft);
}

.notice__title {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.notice__text {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.status-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.45;
}

.status-line__dot {
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-radius: 50%;
  background: var(--green);
}

/* ------------------------------------------------------------
 * 表单
 * ------------------------------------------------------------ */
.form-field {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.form-input,
.form-textarea,
.form-picker {
  width: 100%;
  min-height: 96rpx;
  padding: 0 24rpx;
  border: 1px solid var(--line);
  border-radius: 24rpx;
  background: var(--paper-surface);
  color: var(--ink);
  font-size: 28rpx;
  transition: border-color 160ms ease;
}

.form-placeholder {
  color: var(--ink-placeholder);
}

.form-textarea {
  min-height: 188rpx;
  padding-top: 22rpx;
  line-height: 1.55;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-picker::after {
  width: 12rpx;
  height: 12rpx;
  margin-right: 6rpx;
  border-right: 2rpx solid var(--ink-2);
  border-bottom: 2rpx solid var(--ink-2);
  content: "";
  transform: rotate(45deg) translateY(-4rpx);
}

.form-picker--placeholder {
  color: var(--ink-placeholder);
}

.form-input:focus,
.form-textarea:focus {
  border-color: var(--green);
}

.form-field--error .form-input,
.form-field--error .form-textarea,
.form-field--error .form-picker {
  border-color: var(--error);
}

.form-error {
  margin-top: 10rpx;
  color: var(--error);
  font-size: 22rpx;
  line-height: 1.5;
}

/* ------------------------------------------------------------
 * 筛选片与选项
 * ------------------------------------------------------------ */
.chip-row {
  display: flex;
  gap: 12rpx;
  padding-right: 32rpx;
}

.chip {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  flex: none;
  padding: 0 28rpx;
  border: 1px solid var(--line);
  border-radius: 24rpx;
  background: var(--paper-surface);
  color: var(--ink);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1;
  transition: transform 160ms var(--ease-out), background-color 160ms ease, border-color 160ms ease;
}

.chip--active {
  border-color: var(--green);
  background: var(--green);
  color: #ffffff;
  font-weight: 600;
}

/* ------------------------------------------------------------
 * 空状态与骨架
 * ------------------------------------------------------------ */
.empty-state {
  padding: 88rpx 0;
  border-top: 1px solid var(--line);
  text-align: left;
}

.empty-state__title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.empty-state__text {
  margin-top: 12rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.6;
}

.skeleton {
  overflow: hidden;
  background: var(--paper-tint);
  animation: skeleton-pulse 1.4s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton {
    animation: none;
    opacity: 0.82;
  }
}

/* ------------------------------------------------------------
 * 前后对比：首页与结果页共用同一套控件语言
 * ------------------------------------------------------------ */
.compare-label {
  position: absolute;
  z-index: 2;
  display: flex;
  min-height: 52rpx;
  align-items: center;
  padding: 0 20rpx;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.compare-label--before {
  left: 32rpx;
  background: rgba(38, 44, 35, 0.72);
}

.compare-label--after {
  right: 32rpx;
  background: rgba(36, 66, 51, 0.88);
}

.compare-divider {
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 2;
  width: 3rpx;
  background: #ffffff;
  box-shadow: 0 0 0 1px rgba(31, 44, 36, 0.12);
  will-change: left;
}

.compare-handle {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border: 1px solid rgba(34, 50, 42, 0.16);
  border-radius: 50%;
  background: var(--paper-surface);
  box-shadow: 0 12rpx 28rpx rgba(24, 35, 29, 0.24);
  transform: translate(-50%, -50%);
  transition: transform 160ms var(--ease-out);
}

.compare-handle--dragging {
  transform: translate(-50%, -50%) scale(1.06);
}

.compare-handle__arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid var(--ink);
  border-right: 3rpx solid var(--ink);
}

.compare-handle__arrow--left { transform: rotate(-135deg); }
.compare-handle__arrow--right { transform: rotate(45deg); }

/* ------------------------------------------------------------
