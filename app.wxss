page {
  min-height: 100%;
  background: #f8f5f0;
  color: #262c23;
  font-family: -apple-system, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view,
text,
image,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  overflow: hidden;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 44rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));
}

.with-action-bar {
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.flow-step {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #d8d5ce;
  color: #6f746d;
  font-size: 22rpx;
  font-weight: 650;
}

.flow-step text:last-child {
  color: #244233;
  font-variant-numeric: tabular-nums;
}

.page-title {
  margin-top: 18rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-title text {
  display: block;
}

.page-subtitle {
  max-width: 650rpx;
  margin-top: 14rpx;
  color: #636961;
  font-size: 26rpx;
  line-height: 1.6;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.section-heading__title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-heading__meta {
  color: #565d56;
  font-size: 22rpx;
}

.primary-button,
.secondary-button,
.quiet-button {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  border-radius: 28rpx;
  letter-spacing: 0;
  transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 160ms ease, background-color 160ms ease;
}

.primary-button {
  background: #244233;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid #aeb5ad;
  background: #fffefa;
  color: #244233;
}

.quiet-button {
  background: #e9e8e1;
  color: #3f463f;
}

.primary-button:active,
.secondary-button:active,
.quiet-button:active,
.pressable:active {
  transform: scale(0.985);
  opacity: 0.9;
}

.button-hover {
  transform: scale(0.985);
  opacity: 0.9;
}

button[disabled] {
  opacity: 0.42;
}

.action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 16rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #d8d5ce;
  background: #f8f5f0;
}

.demo-badge {
  display: inline-flex;
  min-height: 44rpx;
  align-items: center;
  padding: 0 16rpx;
  border: 1rpx solid #9eaaa2;
  border-radius: 14rpx;
  background: #e3e8e2;
  color: #244233;
  font-size: 20rpx;
  font-weight: 700;
}

.form-field {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  color: #343a35;
  font-size: 25rpx;
  font-weight: 650;
}

.form-input,
.form-textarea,
.form-picker {
  width: 100%;
  min-height: 96rpx;
  padding: 0 24rpx;
  border: 1rpx solid #c9cbc5;
  border-radius: 24rpx;
  background: #fffefa;
  color: #242824;
  font-size: 28rpx;
}

.form-textarea {
  min-height: 188rpx;
  padding-top: 22rpx;
  line-height: 1.55;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-input:focus,
.form-textarea:focus {
  border-color: #244233;
}

.form-error {
  margin-top: 10rpx;
  color: #a6433b;
  font-size: 22rpx;
}

.empty-state {
  padding: 88rpx 0;
  border-top: 1rpx solid #d8d5ce;
  text-align: left;
}

.empty-state__title {
  font-size: 31rpx;
  font-weight: 700;
}

.empty-state__text {
  margin-top: 12rpx;
  color: #656b64;
  font-size: 25rpx;
  line-height: 1.6;
}

.skeleton {
  overflow: hidden;
  background: #e4e4dc;
  animation: skeleton-pulse 1.4s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton {
    animation: none;
    opacity: 0.82;
  }
}

.page-context {
  color: #596159;
  font-size: 24rpx;
  font-weight: 600;
}
