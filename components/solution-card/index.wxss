.solution-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid #d8d5ce;
  border-radius: 16rpx;
  background: #fffefa;
  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
}

.solution-card--selected {
  border: 3rpx solid #244233;
  box-shadow: 0 12rpx 28rpx rgba(36, 66, 51, 0.1);
}

.solution-card__media {
  position: relative;
  overflow: hidden;
}

.solution-card__image {
  display: block;
  width: 100%;
  height: 340rpx;
  background: #e4e4dc;
}

.solution-card--compact .solution-card__image {
  height: 324rpx;
}

.solution-card--compact {
  border: 0;
  border-radius: 26rpx;
  background: #c9c6bb;
  box-shadow: 0 16rpx 34rpx rgba(34, 50, 42, 0.14);
}

.solution-card__image--compact {
  display: block;
}

.solution-card__compact-shade {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 150rpx;
  background: linear-gradient(180deg, rgba(21, 33, 26, 0), rgba(21, 33, 26, 0.88));
}

.solution-card__compact-copy {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  left: 24rpx;
  color: #ffffff;
}

.solution-card__name--compact {
  font-size: 28rpx;
  text-shadow: 0 3rpx 12rpx rgba(10, 16, 12, 0.32);
}

.solution-card__subtitle--compact {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
  line-height: 1.4;
}

.solution-card__type,
.solution-card__check {
  position: absolute;
  top: 18rpx;
  min-height: 46rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 46rpx;
}

.solution-card__type {
  left: 18rpx;
  background: rgba(248, 245, 240, 0.94);
  color: #39413b;
}

.solution-card__check {
  right: 18rpx;
  background: #244233;
  color: #ffffff;
}

.solution-card__body {
  padding: 28rpx;
}

.solution-card__name {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.solution-card__subtitle {
  margin-top: 8rpx;
  color: #626861;
  font-size: 24rpx;
  line-height: 1.5;
}

.solution-card__features {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 22rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e2dfd8;
}

.solution-card__feature {
  color: #485048;
  font-size: 21rpx;
}

.solution-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
}

.solution-card__swatches {
  display: flex;
  gap: 12rpx;
}

.solution-card__swatch {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx #bfc4be;
}

.solution-card__price {
  max-width: 360rpx;
  color: #697069;
  font-size: 21rpx;
  line-height: 1.45;
  text-align: right;
}
