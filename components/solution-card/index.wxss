.solution-card {
  overflow: hidden;
  border: 1rpx solid #dedfd9;
  border-radius: 8rpx;
  background: #ffffff;
  transition: transform 180ms ease, border-color 180ms ease;
}

.solution-card--selected {
  border: 3rpx solid #285c3a;
}

.solution-card__image {
  display: block;
  width: 100%;
  height: 300rpx;
  background: #e7e8e2;
}

.solution-card--compact .solution-card__image {
  height: 260rpx;
}

.solution-card__body {
  padding: 24rpx;
}

.solution-card__topline,
.solution-card__footer {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.solution-card__name {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.solution-card__subtitle {
  margin-top: 8rpx;
  color: #70746e;
  font-size: 23rpx;
  line-height: 1.45;
}

.solution-card__check {
  flex: none;
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
  background: #285c3a;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
}

.solution-card__features {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.solution-card__feature {
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
  background: #f0f1ec;
  color: #555a55;
  font-size: 21rpx;
}

.solution-card__footer {
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #ecece7;
}

.solution-card__swatches {
  display: flex;
  gap: 10rpx;
}

.solution-card__swatch {
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 1rpx #c9cbc5;
}

.solution-card__price {
  max-width: 360rpx;
  color: #7b7f79;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: right;
}
