.solution-card {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 16rpx;
  background: var(--paper-surface);
  transition: transform 160ms var(--ease-out), border-color 160ms ease, box-shadow 160ms ease;
}

.solution-card--selected {
  border-color: var(--green);
  box-shadow: 0 0 0 2rpx var(--green), 0 12rpx 28rpx rgba(36, 66, 51, 0.12);
}

.solution-card__media {
  position: relative;
  overflow: hidden;
}

.solution-card__image {
  display: block;
  width: 100%;
  height: 340rpx;
  background: var(--paper-tint);
}

.solution-card--compact .solution-card__image {
  height: 252rpx;
}

.solution-card__image--compact {
  display: block;
}

.solution-card__compact-copy {
  padding: 22rpx 24rpx 24rpx;
}

.solution-card__name--compact {
  font-size: 28rpx;
}

.solution-card__subtitle--compact {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.solution-card__check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  min-height: 44rpx;
  align-items: center;
  gap: 6rpx;
  padding: 0 14rpx 0 8rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  background: var(--green);
  color: #ffffff;
}

.solution-card__check .ic {
  width: 32rpx;
  height: 32rpx;
}

.solution-card__body {
  padding: 28rpx;
}

.solution-card__name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.solution-card__subtitle {
  margin-top: 8rpx;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.5;
}

.solution-card__features {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 24rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1px solid var(--line-soft);
}

.solution-card__feature {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--ink);
  font-size: 22rpx;
  line-height: 1.5;
}

.solution-card__feature::before {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--clay);
  content: "";
}

.solution-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
}

.solution-card__swatches {
  display: flex;
  gap: 12rpx;
}

.solution-card__swatch {
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 1px var(--line);
}

.solution-card__price {
  max-width: 360rpx;
  color: var(--ink-2);
  font-size: 22rpx;
  line-height: 1.45;
  text-align: right;
}
